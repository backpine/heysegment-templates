---
/**
 * Terms and Conditions page, lorem ipsum placeholder.
 *
 * Real sites replace the body content with their actual terms.
 *
 * Template-three "playful / blocky / pop-shadow" treatment, consistent
 * with the privacy-policy page: a line-eyebrow + square brand icon tile +
 * blocky Poppins heading on the cream page, then the legal copy wrapped in
 * a single blocky pop-shadow surface card with clean section spacing.
 */
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/global/Breadcrumbs.astro";
import { business } from "@/data/business";

const sections = [
  {
    heading: "1. Acceptance of terms",
    body: "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
  },
  {
    heading: "2. Use of services",
    body: "Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.",
  },
  {
    heading: "3. Pricing and payment",
    body: "Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.",
  },
  {
    heading: "4. Cancellations and refunds",
    body: "Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit, sed quia consequuntur magni dolores eos qui ratione voluptatem sequi nesciunt.",
  },
  {
    heading: "5. Limitation of liability",
    body: "Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse quam nihil molestiae consequatur, vel illum qui dolorem eum fugiat quo voluptas nulla pariatur.",
  },
  {
    heading: "6. Governing law",
    body: "At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident.",
  },
  {
    heading: "7. Contact",
    body: `For questions about these terms, contact us at ${business.email} or call ${business.phone}.`,
  },
];

const lastUpdated = "January 1, 2025";
---

<Layout
  title={`Terms and Conditions, ${business.name}`}
  description={`Terms and Conditions for ${business.name}.`}
  robots="noindex"
>

  <Breadcrumbs trail={[{ label: "Terms and Conditions", href: "/terms-and-conditions" }]} />

  <section class="relative bg-bg pt-12 lg:pt-16 pb-20 lg:pb-28 overflow-hidden">
    {/* Faint icon-accent texture behind the page header for a playful backdrop. */}
    <div class="absolute inset-0 bg-accent-dots pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-3xl mx-auto px-6 lg:px-10">

      {/* Page header — line eyebrow + square icon tile + blocky heading */}
      <header data-reveal data-reveal-from="up">
        <div class="inline-flex items-center gap-2.5 mb-5">
          <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
          <span class="font-heading font-semibold text-sm tracking-widest uppercase text-brand">
            Legal
          </span>
        </div>

        <div class="flex items-center gap-4">
          <span
            class="inline-flex items-center justify-center w-12 h-12 shrink-0 rounded-md bg-brand text-brand-fg shadow-pop-sm"
            aria-hidden="true"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.25">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </span>

          <h1 class="font-heading font-extrabold text-3xl sm:text-4xl lg:text-5xl text-text leading-[1.05] tracking-tight">
            Terms and Conditions
          </h1>
        </div>

        <p class="font-body text-sm text-text-soft mt-5">
          Last updated: {lastUpdated}
        </p>
      </header>

      {/* Legal body wrapped in a blocky pop-shadow surface card */}
      <div
        class="mt-10 bg-surface rounded-md ring-1 ring-text/10 shadow-pop p-7 sm:p-9 lg:p-11"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="150"
      >
        <p class="font-body text-base lg:text-lg text-text-soft leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
        </p>

        <div class="mt-10 space-y-10 divide-y divide-border">
          {sections.map((section, i) => (
            <section class={i === 0 ? "" : "pt-10"}>
              <h2 class="font-heading font-bold text-xl lg:text-2xl text-text leading-snug">
                {section.heading}
              </h2>
              <p class="font-body text-base text-text-soft mt-3 leading-relaxed">
                {section.body}
              </p>
            </section>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
