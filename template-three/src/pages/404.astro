---
/**
 * 404, themed not-found page.
 *
 * Uses Layout so Nav + Footer render around it. Owns its own nav clearance
 * (pt-28 lg:pt-36) like every other top-of-page section per the layout
 * contract.
 *
 * Template-three "playful / blocky / pop-shadow" treatment: a big square
 * brand icon tile, an oversized blocky Poppins "404" lockup, and chunky
 * `.btn-pop` CTAs back into the site, centered on the cream page with a
 * faint accent-dots backdrop. Friendly but clean — not decorative.
 */
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { business } from "@/data/business";

const phoneHref = "tel:+1" + business.phone.replace(/\D/g, "");

// A small set of high-intent destinations rendered as blocky link tiles,
// so a visitor who hit a broken URL lands somewhere useful fast.
const helpfulLinks = [
  { label: "Services", description: "See everything we offer", href: "/services" },
  { label: "Service Area", description: "Check if we cover you", href: "/service-area" },
  { label: "Gallery", description: "Browse recent work", href: "/gallery" },
  { label: "FAQ", description: "Get quick answers", href: "/faq" },
];
---

<Layout
  title={`Page not found, ${business.name}`}
  description="The page you're looking for isn't here."
  robots="noindex"
>
  <section class="relative bg-bg overflow-hidden">
    {/* Faint icon-accent texture for the playful blocky backdrop. */}
    <div class="absolute inset-0 bg-accent-dots pointer-events-none" aria-hidden="true"></div>

    <div class="relative max-w-3xl mx-auto px-6 lg:px-10 pt-28 lg:pt-36 pb-20 lg:pb-28 min-h-[72vh] flex flex-col items-center justify-center text-center">

      {/* Big square brand icon tile */}
      <span
        class="inline-flex items-center justify-center w-16 h-16 rounded-md bg-brand text-brand-fg shadow-pop"
        data-reveal
        data-reveal-from="up"
        aria-hidden="true"
      >
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
        </svg>
      </span>

      {/* Eyebrow */}
      <p
        class="font-heading font-semibold text-sm tracking-widest uppercase text-brand mt-7"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        Error 404
      </p>

      {/* Oversized blocky headline */}
      <h1
        class="font-heading font-extrabold text-4xl sm:text-5xl lg:text-6xl text-text leading-[1.05] tracking-tight mt-4"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="200"
      >
        Page not found.
      </h1>

      <p
        class="font-body text-base lg:text-lg text-text-soft mt-5 leading-relaxed max-w-xl"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="300"
      >
        We looked everywhere and couldn't find that page. The link may be broken
        or the page may have moved. Let's get you back on track.
      </p>

      {/* Primary CTAs */}
      <div
        class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center gap-3 sm:gap-4 mt-10"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="400"
      >
        <a
          href="/"
          class="btn-pop inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-deep text-brand-fg font-heading font-semibold rounded-pill px-7 py-3.5"
        >
          <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          Back to home
        </a>
        <a
          href="/contact"
          class="btn-pop inline-flex items-center justify-center gap-2 bg-surface hover:bg-brand-tint text-text font-heading font-semibold rounded-pill px-7 py-3.5 ring-1 ring-text/10"
        >
          Contact us
          <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>

      {/* Helpful links as blocky pop cards */}
      <div class="mt-14 w-full">
        <p
          class="font-heading font-semibold text-sm tracking-widest uppercase text-text-soft mb-5"
          data-reveal
          data-reveal-from="up"
        >
          Popular pages
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left" role="list">
          {helpfulLinks.map((link, i) => (
            <li
              data-reveal
              data-reveal-from="up"
              data-reveal-delay={String(Math.min(i * 75, 300)) as "0" | "75" | "150" | "225" | "300"}
            >
              <a
                href={link.href}
                class="group flex items-center gap-4 bg-surface rounded-md ring-1 ring-text/10 shadow-pop-sm px-5 py-4 transition-transform duration-150 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
              >
                <span class="inline-flex items-center justify-center w-12 h-12 shrink-0 rounded-md bg-brand-tint text-brand">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="block font-heading font-bold text-base text-text leading-snug">
                    {link.label}
                  </span>
                  <span class="block font-body text-sm text-text-soft mt-0.5 leading-snug">
                    {link.description}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Phone fallback */}
      <p
        class="font-body text-sm text-text-soft mt-12"
        data-reveal
        data-reveal-from="up"
      >
        Still stuck? Call us at{" "}
        <a href={phoneHref} class="font-semibold text-brand hover:text-brand-deep transition-colors">
          {business.phone}
        </a>
      </p>

    </div>
  </section>
</Layout>
