---
import { Font } from "astro:assets";
import "@/styles/global.css";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import BusinessSchema from "@/components/global/BusinessSchema.astro";
import { business } from "@/data/business";

interface Props {
  // Core metadata
  title?: string;
  description?: string;
  canonical?: string;

  // Open Graph
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageWidth?: string;
  ogImageHeight?: string;
  ogType?: string;
  ogUrl?: string;
  ogSiteName?: string;
  ogLocale?: string;

  // Twitter
  twitterCard?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  twitterSite?: string;

  // Robots & indexing
  robots?: string;

  // Geo
  geoRegion?: string;
  geoPlacename?: string;
  geoPosition?: string; // "latitude;longitude"

  // Theme & branding
  themeColor?: string;
  author?: string;

  // Performance hints
  preconnect?: string[]; // array of URLs to preconnect
  dnsPrefetch?: string[]; // array of URLs to DNS prefetch
}

const {
  title,
  description,
  canonical,

  ogTitle,
  ogDescription,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType,
  ogUrl,
  ogSiteName,
  ogLocale,

  twitterCard,
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterSite,

  robots,

  geoRegion,
  geoPlacename,
  geoPosition,

  themeColor,
  author,

  preconnect,
  dnsPrefetch,
} = Astro.props;

// Default social-share image, the branded 1200x630 OG card. Pages can
// override by passing `ogImage` (and matching width/height). siteUrl is the
// canonical origin from business data (no trailing slash).
const siteUrl = business.siteUrl.replace(/\/$/, "");
const defaultOgImage = `${siteUrl}/og-default.png`;

const resolvedOgImage = ogImage ?? defaultOgImage;
const resolvedOgImageWidth = ogImage ? ogImageWidth : (ogImageWidth ?? "1200");
const resolvedOgImageHeight = ogImage ? ogImageHeight : (ogImageHeight ?? "630");

const resolvedTwitterImage = twitterImage ?? resolvedOgImage;
const resolvedTwitterCard = twitterCard ?? "summary_large_image";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-provider-body" preload />
    <Font cssVariable="--font-provider-heading" preload />

    {/* Core metadata */}
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
    {robots && <meta name="robots" content={robots} />}
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Author */}
    {author && <meta name="author" content={author} />}

    {/* Geo targeting */}
    {geoRegion && <meta name="geo.region" content={geoRegion} />}
    {geoPlacename && <meta name="geo.placename" content={geoPlacename} />}
    {geoPosition && <meta name="geo.position" content={geoPosition} />}
    {geoPosition && <meta name="ICBM" content={geoPosition.replace(';', ', ')} />}

    {/* Theme color */}
    {themeColor && <meta name="theme-color" content={themeColor} />}

    {/* Open Graph */}
    {ogType && <meta property="og:type" content={ogType} />}
    {ogSiteName && <meta property="og:site_name" content={ogSiteName} />}
    {ogLocale && <meta property="og:locale" content={ogLocale} />}
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImageWidth && <meta property="og:image:width" content={resolvedOgImageWidth} />}
    {resolvedOgImageHeight && <meta property="og:image:height" content={resolvedOgImageHeight} />}

    {/* Twitter Card */}
    {resolvedTwitterCard && <meta name="twitter:card" content={resolvedTwitterCard} />}
    {twitterTitle && <meta name="twitter:title" content={twitterTitle} />}
    {twitterDescription && <meta name="twitter:description" content={twitterDescription} />}
    {resolvedTwitterImage && <meta name="twitter:image" content={resolvedTwitterImage} />}
    {twitterSite && <meta name="twitter:site" content={twitterSite} />}

    {/* Performance hints */}
    {preconnect?.map(url => <link rel="preconnect" href={url} />)}
    {dnsPrefetch?.map(url => <link rel="dns-prefetch" href={url} />)}

    {/* Sitewide LocalBusiness JSON-LD (NAP, hours, rating, area served). */}
    <BusinessSchema />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    {/* No padding here, sections paint edge-to-edge so a dark or image hero
        can extend its background behind the floating nav pill. Each section
        that sits at the top or bottom of the page is responsible for leaving
        its own clearance for the floating bars. */}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    {/* Universal scroll-reveal observer, watches every [data-reveal]
        element and animates it in when scrolled into view. */}
    <script>
      import "@/scripts/scroll-reveal.ts";
    </script>
  </body>
</html>
