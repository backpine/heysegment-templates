---
/**
 * TestimonialsTeal, template-three variant: dark "What your neighbors
 * are saying" band with blocky pop review cards (Smart Scoops style).
 *
 * Full-bleed near-black section, white heading, and a row of chunky
 * review cards with the signature offset "pop" shadow (brand-orange so
 * it stays visible on the dark band). The MIDDLE card is highlighted in
 * solid orange to break the rhythm, like the reference. No wave
 * dividers — hard straight edges.
 *
 * Component name + props preserved so consuming pages keep working; the
 * wave-related props are accepted but no-op in template-three.
 */
import { business } from "@/data/business";
import StarRating from "@/components/ui/StarRating.astro";

interface Review {
  name: string;
  rating: number;
  text: string;
  subheading?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  reviews?: Review[];
  ctaLabel?: string;
  ctaHref?: string;
  /** Accepted for API parity; no-op in template-three (no waves). */
  omitTopWave?: boolean;
  omitBottomWave?: boolean;
  tightBottom?: boolean;
  bottomWaveBg?: "bg" | "surface";
  topWaveBg?: "bg" | "surface";
}

const {
  eyebrow = "Reviews",
  heading = "What your neighbors are saying!",
  reviews = business.reviews.items.slice(0, 3),
  ctaLabel = "See All Our Reviews",
  ctaHref = "/reviews",
} = Astro.props;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
---

<section class="bg-text text-surface py-20 lg:py-28 relative overflow-hidden">

  {/* Faint icon-accent texture */}
  <div class="absolute inset-0 bg-accent-dots-light opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-16">
      {eyebrow && (
        <p
          class="font-heading font-semibold text-sm tracking-widest uppercase text-brand mb-4"
          data-reveal
          data-reveal-from="up"
        >
          {eyebrow}
        </p>
      )}
      <h2
        class="font-heading font-extrabold text-4xl lg:text-5xl text-surface leading-[1.1]"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        {heading}
      </h2>
    </div>

    <!-- Review cards, blocky pop. Middle card highlighted orange. -->
    <ul
      class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8"
      role="list"
    >
      {reviews.map((review, i) => {
        const highlight = i === 1;
        return (
          <li
            class:list={[
              "rounded-md shadow-pop-brand p-6 lg:p-7 flex flex-col transition-transform duration-150 hover:-translate-y-1",
              highlight ? "bg-brand text-brand-fg" : "bg-surface text-text",
            ]}
            data-reveal
            data-reveal-from="up"
            data-reveal-delay={String(i * 150) as "0" | "100" | "200" | "300" | "500" | "700"}
          >
            <header class="flex items-center gap-3 mb-4">
              <span
                class:list={[
                  "inline-flex items-center justify-center w-12 h-12 rounded-md font-heading font-bold text-base shrink-0",
                  highlight ? "bg-brand-fg/20 text-brand-fg" : "bg-brand-tint text-brand",
                ]}
              >
                {initials(review.name)}
              </span>
              <div class="min-w-0">
                <p class:list={["font-heading font-bold text-sm leading-tight truncate", highlight ? "text-brand-fg" : "text-text"]}>
                  {review.name}
                </p>
                <StarRating
                  count={review.rating}
                  class="flex gap-0.5 mt-1"
                  starClass="w-3.5 h-3.5"
                />
              </div>
            </header>

            {review.subheading && (
              <p class:list={[
                "font-heading font-semibold text-xs tracking-widest uppercase mb-3 pb-3 border-b",
                highlight ? "text-brand-fg/90 border-brand-fg/25" : "text-brand border-border",
              ]}>
                {review.subheading}
              </p>
            )}

            <p class:list={["font-body text-sm leading-relaxed flex-1", highlight ? "text-brand-fg/95" : "text-text-soft"]}>
              &ldquo;{review.text}&rdquo;
            </p>
          </li>
        );
      })}
    </ul>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
        href={ctaHref}
        class="btn-pop inline-flex items-center gap-2 bg-surface text-text font-heading font-semibold text-sm px-8 py-4 rounded-pill hover:bg-brand-tint"
      >
        {ctaLabel}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
