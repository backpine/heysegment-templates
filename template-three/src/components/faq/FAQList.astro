---
/**
 * FAQList, the full categorized FAQ for the /faq page.
 *
 * Template-three "playful / blocky / pop-shadow" treatment:
 *   - Zero JavaScript — every question is a native <details>/<summary>
 *     blocky pop card (matching the home FAQ: bg-surface rounded-md,
 *     ring, shadow-pop-sm → open:shadow-pop, square brand-tint +/×
 *     toggle tile).
 *   - Structurally distinct from t1/t2 (which render flat hairline-
 *     divider lists) AND from the home FAQ (one flat stack): here the
 *     page is a TWO-COLUMN layout. A sticky CATEGORY INDEX rail on the
 *     left lists every category as blocky pop anchor pills; the right
 *     column groups the cards under numbered square-tile category
 *     headers, one stack per category.
 *   - Section sits on cream with a drifting AccentField texture.
 */
import { business } from "@/data/business";

interface Question {
  question: string;
  answer: string;
}

interface FAQCategory {
  category: string;
  questions: Question[];
}

interface Props {
  eyebrow?: string;
  heading?: string;
  categories?: FAQCategory[];
}

const {
  eyebrow = "Answers",
  heading = "Everything you might be wondering.",
  categories = business.faqs,
} = Astro.props;

// Stable anchor slugs for the index rail → grouped card stacks.
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const groups = categories.map((cat, i) => ({
  ...cat,
  id: `faq-${slugify(cat.category)}`,
  num: String(i + 1).padStart(2, "0"),
}));
---

<section class="relative bg-bg py-20 lg:py-28">
  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="max-w-2xl mb-12 lg:mb-16">
      {eyebrow && (
        <p
          class="font-heading font-semibold text-sm tracking-widest uppercase text-brand mb-4"
          data-reveal
          data-reveal-from="left"
        >
          {eyebrow}
        </p>
      )}
      <h2
        class="font-heading font-extrabold tracking-tight text-3xl lg:text-5xl text-text leading-[1.1]"
        data-reveal
        data-reveal-from="left"
        data-reveal-delay="100"
      >
        {heading}
      </h2>
    </div>

    <div class="grid lg:grid-cols-[16rem_1fr] gap-10 lg:gap-14">

      <!-- Left: sticky category index, blocky pop anchor pills -->
      <aside
        class="lg:sticky lg:top-28 lg:self-start"
        data-reveal
        data-reveal-from="left"
        data-reveal-delay="200"
      >
        <p class="font-heading font-semibold text-xs tracking-widest uppercase text-text-soft mb-4">
          Jump to a topic
        </p>
        <nav class="flex flex-wrap lg:flex-col gap-2.5" aria-label="FAQ categories">
          {groups.map((g) => (
            <a
              href={`#${g.id}`}
              class="btn-pop group/idx inline-flex items-center gap-3 bg-surface text-text rounded-md ring-1 ring-text/10 px-3.5 py-2.5 hover:bg-brand-tint"
            >
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-brand-tint text-brand font-heading text-xs font-extrabold shrink-0 group-hover/idx:bg-brand group-hover/idx:text-brand-fg transition-colors">
                {g.num}
              </span>
              <span class="font-heading font-semibold text-sm leading-tight">
                {g.category}
              </span>
            </a>
          ))}
        </nav>
      </aside>

      <!-- Right: grouped accordion card stacks, one block per category -->
      <div class="space-y-12 lg:space-y-16 min-w-0">
        {groups.map((g) => (
          <div id={g.id} class="scroll-mt-28">
            <!-- Category header: numbered square tile + label -->
            <div
              class="flex items-center gap-3.5 mb-5"
              data-reveal
              data-reveal-from="up"
            >
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand text-brand-fg shadow-pop-sm font-heading text-base font-extrabold shrink-0">
                {g.num}
              </span>
              <h3 class="font-heading font-extrabold tracking-tight text-xl lg:text-2xl text-text leading-tight">
                {g.category}
              </h3>
            </div>

            <!-- Blocky pop accordion cards -->
            <div class="space-y-3">
              {g.questions.map((item) => (
                <details class="group bg-surface rounded-md ring-1 ring-text/10 shadow-pop-sm open:shadow-pop transition-shadow">
                  <summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-5">
                    <span class="font-heading font-semibold text-base text-text group-open:text-brand transition-colors pr-2">
                      {item.question}
                    </span>
                    <span
                      class="shrink-0 mt-0.5 inline-flex items-center justify-center w-7 h-7 rounded-md bg-brand-tint text-brand"
                      aria-hidden="true"
                    >
                      <svg
                        class="w-4 h-4 group-open:rotate-45 transition-transform duration-200"
                        fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                      </svg>
                    </span>
                  </summary>
                  <p class="font-body text-base text-text-soft leading-relaxed px-5 pb-5 pr-12">
                    {item.answer}
                  </p>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>
