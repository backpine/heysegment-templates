---
/**
 * ValuesGrid, the "what we believe" section (template-three).
 *
 * Template-three reskin — blocky pop language, deliberately
 * restructured away from t1/t2 (which both use a centered header with an
 * italic accent line above a grid of VERTICAL round-disc icon cards):
 *
 *   - Header is a LEFT-aligned editorial block (eyebrow chip-rule +
 *     heading + sub-headline), not centered.
 *   - Values render as HORIZONTAL pop cards — a square (blocky) icon
 *     tile on the LEFT, a big ghosted index numeral, then title + copy
 *     on the right. This is the opposite axis from the vertical
 *     disc-on-top cards both siblings use.
 *   - Cards alternate accent (every other card flips to a solid
 *     brand-tint fill) to break the rhythm, echoing TestimonialsTeal.
 *   - rounded-md + shadow-pop + hover lift; NO rounded-2xl, NO
 *     rounded-full discs, NO shadow-lg, NO italic.
 *
 * Reads `business.values`. Adapts column count to item count.
 */
import { business } from "@/data/business";

interface Value {
  title: string;
  description: string;
  icon?: "shield" | "wrench" | "check" | "calendar" | "phone" | "quote";
}

interface Props {
  eyebrow?: string;
  heading?: string;
  /** Sub-headline shown beneath the heading. */
  accent?: string;
  items?: Value[];
}

const data = (business as { values?: Value[] }).values;

const {
  eyebrow = "What We Believe",
  heading = "The values behind every job.",
  accent = "The standards we hold ourselves to on every single visit.",
  items = data ?? [],
} = Astro.props;

const iconPath: Record<NonNullable<Value["icon"]>, string> = {
  shield: "M9 12l2 2 4-4M12 2L4 6v6c0 5.5 3.84 10.74 8 12 4.16-1.26 8-6.5 8-12V6l-8-4z",
  wrench: "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  check: "M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  calendar: "M8 7V3m8 4V3M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  quote: "M3 5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM8 11h8M8 15h5",
};

// Horizontal cards read well stacked or 2-up; a single value centers,
// everything else flows into a 2-column grid of wide cards.
const gridColsClass =
  items.length === 1
    ? "grid-cols-1 max-w-xl mx-auto"
    : "grid-cols-1 lg:grid-cols-2";

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="bg-surface py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- LEFT-aligned editorial header -->
    <div class="max-w-2xl mb-12 lg:mb-16">
      {eyebrow && (
        <div
          class="inline-flex items-center gap-2.5 mb-4"
          data-reveal
          data-reveal-from="up"
        >
          <span class="block w-1.5 h-6 bg-brand rounded-sm" aria-hidden="true"></span>
          <span class="font-heading text-sm font-semibold tracking-widest uppercase text-brand">
            {eyebrow}
          </span>
        </div>
      )}

      {heading && (
        <h2
          class="font-heading font-extrabold text-3xl lg:text-5xl text-text leading-[1.1] tracking-tight"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay="100"
        >
          {heading}
        </h2>
      )}

      {accent && (
        <p
          class="font-body text-base lg:text-lg text-text-soft mt-5 leading-relaxed"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay="200"
        >
          {accent}
        </p>
      )}
    </div>

    <!-- Horizontal value cards, alternating accent fill -->
    <ul
      class:list={["grid gap-6 lg:gap-8", gridColsClass]}
      role="list"
    >
      {items.map((item, i) => {
        const highlight = i % 2 === 1;
        return (
          <li
            class:list={[
              "group flex items-start gap-5 rounded-md shadow-pop ring-1 p-6 lg:p-7 transition-transform duration-150 hover:-translate-y-1",
              highlight
                ? "bg-brand-tint ring-text/10"
                : "bg-bg ring-text/10",
            ]}
            data-reveal
            data-reveal-from="up"
            data-reveal-delay={String(Math.min(i * 100, 300)) as "0" | "100" | "200" | "300"}
          >
            {/* Square (blocky) icon tile */}
            <span
              class:list={[
                "inline-flex items-center justify-center w-14 h-14 rounded-md shadow-pop-sm shrink-0",
                highlight ? "bg-brand text-brand-fg" : "bg-brand-tint text-brand",
              ]}
            >
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPath[item.icon ?? "check"]} />
              </svg>
            </span>

            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-3">
                <h3 class="font-heading font-bold text-lg lg:text-xl text-text leading-snug">
                  {item.title}
                </h3>
                <span class="font-heading font-extrabold text-2xl text-text/10 tabular-nums leading-none ml-auto" aria-hidden="true">
                  {pad(i)}
                </span>
              </div>
              <p class="font-body text-sm lg:text-base text-text-soft mt-2.5 leading-relaxed">
                {item.description}
              </p>
            </div>
          </li>
        );
      })}
    </ul>

  </div>
</section>
