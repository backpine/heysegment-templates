---
/**
 * LocationAbout, "About [City]" section that anchors the page in
 * the local community.
 *
 * Template-three composition (deliberately different from t1/t2's
 * "copy-left / photo-collage-right" split):
 *   - A centered eyebrow + headline band leads the section.
 *   - A snapshot-style tilted city photo with a solid brand accent
 *     block peeking behind it (the t3 photo motif) sits beside a stack
 *     of blocky pop "info" cards — each with its own square icon tile —
 *     for the intro / why-here / history copy. No stacked border
 *     dividers.
 *   - Landmarks + neighborhoods render as real blocky brand-tint chips
 *     (not CSS-multicolumn lists), grouped into two blocky pop panels.
 *   - A drifting AccentField textures the whole section.
 */
import ImagePlaceholder from "@/components/ui/ImagePlaceholder.astro";

interface Props {
  cityName: string;
  /** Headline-level intro paragraph, "we proudly serve [city]". */
  intro?: string;
  /** Why we serve here paragraph, the local-relevance angle. */
  whyHere?: string;
  /** City history paragraph. */
  history?: string;
  landmarks?: string[];
  neighborhoods?: string[];
}

const {
  cityName,
  intro,
  whyHere,
  history,
  landmarks = [],
  neighborhoods = [],
} = Astro.props;

// Build the blocky info cards from whatever copy was supplied, each
// with its own square icon tile + label.
const infoCards = [
  intro && {
    label: "Our promise",
    title: `Local pros in ${cityName}`,
    body: intro,
    icon: "M5 13l4 4L19 7",
  },
  whyHere && {
    label: "Why we're here",
    title: `Why we serve ${cityName}`,
    body: whyHere,
    icon: "M11.48 3.5a.56.56 0 011.04 0l2.12 5.11 5.52.44a.56.56 0 01.32.98l-4.2 3.6 1.28 5.39a.56.56 0 01-.84.6L12 16.3l-4.72 2.83a.56.56 0 01-.84-.6l1.28-5.4-4.2-3.6a.56.56 0 01.32-.98l5.52-.44 2.12-5.1z",
  },
  history && {
    label: "Local roots",
    title: `A little about ${cityName}`,
    body: history,
    icon: "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10",
  },
].filter(Boolean) as { label: string; title: string; body: string; icon: string }[];
---

<section class="bg-bg py-20 lg:py-28 relative">
  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Centered header band -->
    <div class="max-w-2xl mx-auto text-center mb-14 lg:mb-20">
      <p
        class="font-heading font-semibold text-sm tracking-widest uppercase text-brand mb-4"
        data-reveal
        data-reveal-from="up"
      >
        About {cityName}
      </p>
      <h2
        class="font-heading font-extrabold text-4xl lg:text-5xl text-text leading-[1.1] tracking-tight"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        We're proud to serve <span class="text-brand">{cityName}</span>.
      </h2>
    </div>

    <!-- Top row: snapshot photo (left) + stacked blocky info cards (right) -->
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- LEFT: tilted snapshot-stack city photo with brand accent block -->
      <div class="lg:col-span-5">
        <div
          class="relative px-2 sm:px-6 lg:px-2"
          data-reveal
          data-reveal-from="left"
        >
          {/* Solid brand accent block behind, carrying the dot texture */}
          <div
            class="absolute -top-5 -left-3 lg:-left-6 w-28 h-28 lg:w-40 lg:h-40 rounded-md bg-brand bg-accent-dots-light shadow-pop-sm z-0 hidden sm:block"
            aria-hidden="true"
          ></div>

          {/* Main city photo, slight playful tilt */}
          <div class="relative z-10 -rotate-1 rounded-md overflow-hidden ring-1 ring-text/10 shadow-pop">
            <ImagePlaceholder
              aspect="5/4"
              label={`${cityName.toUpperCase()} PHOTO`}
              hint={`Wide shot of ${cityName} skyline or recognizable place`}
              bloomPosition="tr"
            />
          </div>

          {/* Inset work photo dropped on top, tilted the other way */}
          <div class="absolute -bottom-8 -right-3 lg:-right-8 w-2/5 z-20 rotate-3 ring-4 ring-bg rounded-md overflow-hidden shadow-pop">
            <ImagePlaceholder
              aspect="4/3"
              label="WORK PHOTO"
              hint={`Job site in ${cityName}`}
              bloomPosition="bl"
            />
          </div>
        </div>
      </div>

      <!-- RIGHT: blocky pop info cards, each with a square icon tile -->
      <div class="lg:col-span-7 space-y-5">
        {infoCards.map((card, i) => (
          <article
            class="flex gap-5 bg-surface rounded-md ring-1 ring-text/10 shadow-pop p-6 lg:p-7 transition-transform duration-150 hover:-translate-y-1"
            data-reveal
            data-reveal-from="right"
            data-reveal-delay={String(Math.min(i * 100, 300)) as "0" | "100" | "200" | "300"}
          >
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand-tint text-brand shadow-pop-sm shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={card.icon} />
              </svg>
            </span>
            <div>
              <p class="font-heading text-xs font-semibold tracking-widest uppercase text-brand mb-1.5">
                {card.label}
              </p>
              <h3 class="font-heading font-bold text-lg lg:text-xl text-text leading-snug">
                {card.title}
              </h3>
              <p class="font-body text-base text-text-soft mt-2 leading-relaxed">
                {card.body}
              </p>
            </div>
          </article>
        ))}
      </div>

    </div>

    {/* Bottom row: landmark + neighborhood chip panels. Two blocky pop
        panels side by side, each holding real brand-tint chips. */}
    {(landmarks.length > 0 || neighborhoods.length > 0) && (
      <div class="grid md:grid-cols-2 gap-6 lg:gap-8 mt-12 lg:mt-16">

        {landmarks.length > 0 && (
          <div
            class="bg-surface rounded-md ring-1 ring-text/10 shadow-pop p-6 lg:p-8"
            data-reveal
            data-reveal-from="up"
            data-reveal-delay="100"
          >
            <div class="flex items-center gap-3 mb-5">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand text-brand-fg shadow-pop-sm shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </span>
              <p class="font-heading font-bold text-lg lg:text-xl text-text leading-tight">
                Local landmarks we know
              </p>
            </div>
            <ul class="flex flex-wrap gap-2" role="list">
              {landmarks.map((landmark) => (
                <li>
                  <span class="inline-flex items-center gap-1.5 bg-brand-tint text-text font-heading text-xs font-semibold px-3 py-1.5 rounded-md ring-1 ring-text/10">
                    <svg class="w-3.5 h-3.5 text-brand shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 4.314 6 10 6 10s6-5.686 6-10a6 6 0 00-6-6zm0 8a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                    </svg>
                    {landmark}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {neighborhoods.length > 0 && (
          <div
            class="bg-surface rounded-md ring-1 ring-text/10 shadow-pop p-6 lg:p-8"
            data-reveal
            data-reveal-from="up"
            data-reveal-delay="200"
          >
            <div class="flex items-center gap-3 mb-5">
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand text-brand-fg shadow-pop-sm shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10"/>
                </svg>
              </span>
              <p class="font-heading font-bold text-lg lg:text-xl text-text leading-tight">
                Neighborhoods we cover
              </p>
            </div>
            <ul class="flex flex-wrap gap-2" role="list">
              {neighborhoods.map((hood) => (
                <li>
                  <span class="inline-flex items-center gap-1.5 bg-brand-tint text-text font-heading text-xs font-semibold px-3 py-1.5 rounded-md ring-1 ring-text/10">
                    <svg class="w-3.5 h-3.5 text-brand shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    {hood}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    )}

  </div>
</section>
