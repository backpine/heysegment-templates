---
/**
 * Site-wide footer with embedded map on the right.
 *
 * Left column: brand, contact, link groups, service areas.
 * Right column: live map loaded client-side via heysegment-sdk.
 *
 * Used by Layout.astro, rendered on every page automatically.
 */
import { business } from "@/data/business";

interface Props {
  businessName?: string;
  tagline?: string;
  phone?: string;
  email?: string;
  address?: string;
  hours?: Array<{ days: string; time: string }>;
  links?: Array<{ label: string; href: string }>;
  serviceAreas?: string[];
}

const {
  businessName = business.name,
  tagline = business.tagline,
  phone = business.phone,
  email = business.email,
  address = business.address.full,
  hours = business.hours,
  links = business.nav,
  serviceAreas = business.serviceAreas,
} = Astro.props;

const phoneHref = "tel:+1" + phone.replace(/\D/g, "");
const year = new Date().getFullYear();

// Footer services list. Categories only (sub-services excluded), capped
// at 5 so the column stays compact. Entries with dedicated detail pages
// get linked; the rest render as plain text so we never link to a 404.
const detailSlugs = new Set(business.serviceDetails.map((d) => d.slug));
const FOOTER_SERVICE_LIMIT = 5;
const footerServices = business.services
  .filter((s) => !("parentSlug" in s) || !s.parentSlug)
  .slice(0, FOOTER_SERVICE_LIMIT)
  .map((s) => ({
    name: s.name,
    href: detailSlugs.has(s.slug) ? `/services/${s.slug}` : null,
  }));

// Footer service-areas list, capped at 5.
const FOOTER_AREA_LIMIT = 5;
const footerServiceAreas = serviceAreas.slice(0, FOOTER_AREA_LIMIT);

// Social links. Driven by business.socialPlatforms ({ name, href, icon });
// only the platforms listed there render, so a business with no TikTok
// simply omits it from the data. Hrefs are placeholders until wired to
// the client's real profile URLs.
const socials = (business as { socialPlatforms?: Array<{ name: string; href: string; icon: string }> }).socialPlatforms ?? [];

// Brand-glyph paths (single-path, 24x24, fill style). Add new platforms
// here as the data grows.
const SOCIAL_ICONS: Record<string, string> = {
  facebook:  "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
  instagram: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.015 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.015 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z",
  google:    "M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z",
  youtube:   "M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z",
  x:         "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  twitter:   "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  linkedin:  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  tiktok:    "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z",
  yelp:      "M20.16 12.594l-4.995 1.433c-.96.276-1.74-.8-1.176-1.63l2.905-4.308a.49.49 0 01.793-.039 7.541 7.541 0 011.674 3.461.49.49 0 01-.201.722zm-5.105 3.397l3.397 3.397a.49.49 0 01-.06.74 7.54 7.54 0 01-3.461 1.674.49.49 0 01-.583-.482v-5.196c0-.97 1.22-1.412 1.707-.847zm-2.524 1.32v5.196a.49.49 0 01-.583.482 7.54 7.54 0 01-3.461-1.674.49.49 0 01-.06-.74l3.397-3.397c.487-.565 1.707-.123 1.707.847zM4.84 12.594a.49.49 0 01-.201-.722 7.541 7.541 0 011.674-3.461.49.49 0 01.793.039l2.905 4.308c.564.83-.216 1.906-1.176 1.63L4.84 12.594zm6.426-4.05L8.36 3.55a.49.49 0 01.27-.717A11.3 11.3 0 0112 2.4c.49 0 .883.39.883.88v3.978c0 .98-1.24 1.41-1.617.286z",
};
const socialIcon = (key: string) => SOCIAL_ICONS[key] ?? SOCIAL_ICONS.google;
---

<footer class="bg-text text-surface">
  {/* Bottom padding is larger below lg so the floating mobile/tablet action
      bar in Nav.astro (lg:hidden) doesn't cover the copyright row. */}
  <div class="max-w-7xl mx-auto px-6 lg:px-10 pt-12 lg:pt-14 pb-24 lg:pb-6">

    <!-- TOP: 5-column flat row spanning full footer width.
         Brand block (col-span-4) carries contact info; the four link
         columns share the remaining 8 cols (2/2/2/2). On smaller widths
         the columns stack into a 2-up grid. -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-x-8 gap-y-10 pb-10 border-b border-surface/10">

      <!-- Brand + contact -->
      <div class="sm:col-span-2 lg:col-span-4">
        {/* Logo lockup: chunky placeholder mark + wordmark. Mirrors the
            nav lockup so brand reads consistently top + bottom. Real
            sites swap the inner <svg> for their logo file (img/Image);
            keep it inside the brand tile so the lockup spacing holds. */}
        <a
          href="/"
          class="inline-flex items-center gap-3 group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand rounded-md"
          aria-label={`${businessName}, Home`}
        >
          <span class="w-14 h-14 rounded-md bg-brand flex items-center justify-center shrink-0 ring-1 ring-surface/15 transition-transform duration-200 group-hover:-translate-y-0.5">
            <svg class="w-8 h-8 text-brand-fg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
              <path
                d="M16 3 L27 7 V16 C27 22 22 27 16 29 C10 27 5 22 5 16 V7 L16 3 Z"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linejoin="round"
                fill="none"
              />
              <path
                d="M16 10 C18.5 13.5 21 16 21 18.5 A5 5 0 0 1 11 18.5 C11 16 13.5 13.5 16 10 Z"
                fill="currentColor"
              />
              <circle cx="14" cy="20" r="1.25" fill="rgba(255,255,255,0.55)" />
            </svg>
          </span>
          <span class="font-heading font-extrabold text-2xl text-surface leading-none tracking-tight">
            {businessName}
          </span>
        </a>
        <p class="font-body text-sm text-surface/55 mt-4 max-w-md leading-relaxed">
          {tagline}
        </p>

        <div class="mt-5 space-y-2.5">
          <a
            href={phoneHref}
            class="inline-flex items-center gap-2.5 font-body text-sm font-semibold text-surface hover:text-brand-tint transition-colors"
          >
            <svg class="w-4 h-4 text-brand-tint/70 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
            </svg>
            {phone}
          </a>
          <a
            href={`mailto:${email}`}
            class="flex items-center gap-2.5 font-body text-sm text-surface/60 hover:text-surface transition-colors w-fit"
          >
            <svg class="w-4 h-4 text-surface/40 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            {email}
          </a>
          <p class="flex items-start gap-2.5 font-body text-sm text-surface/60">
            <svg class="w-4 h-4 mt-0.5 text-surface/35 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            {address}
          </p>
        </div>

        {/* Social media icons — placeholder links, swap hrefs in
            business.socialPlatforms. Blocky pop tiles that flip to brand
            on hover, matching the template-three button language. */}
        {socials.length > 0 && (
          <div class="mt-7">
            <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40 mb-3">
              Follow Us
            </p>
            <ul class="flex flex-wrap items-center gap-2.5" role="list">
              {socials.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.name}
                    class="w-10 h-10 inline-flex items-center justify-center rounded-md bg-surface/10 text-surface/75 ring-1 ring-surface/10 hover:bg-brand hover:text-brand-fg hover:-translate-y-0.5 transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
                  >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" clip-rule="evenodd" d={socialIcon(s.icon)} />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Navigation -->
      <div class="lg:col-span-2">
        <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40 mb-4">
          Navigation
        </p>
        <ul class="space-y-2" role="list">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-body text-sm text-surface/65 hover:text-surface transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services (top 5 categories, no sub-services) -->
      <div class="lg:col-span-2">
        <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40 mb-4">
          Services
        </p>
        <ul class="space-y-2" role="list">
          {footerServices.map((service) => (
            <li>
              {service.href ? (
                <a
                  href={service.href}
                  class="font-body text-sm text-surface/65 hover:text-surface transition-colors"
                >
                  {service.name}
                </a>
              ) : (
                <span class="font-body text-sm text-surface/55">{service.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Hours -->
      <div class="lg:col-span-2">
        <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40 mb-4">
          Hours
        </p>
        <ul class="space-y-2" role="list">
          {hours.map((row) => (
            <li class="font-body text-sm">
              <p class="text-surface/85">{row.days}</p>
              <p class="text-surface/50">{row.time}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Service areas (top 5) -->
      <div class="sm:col-span-2 lg:col-span-2">
        <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40 mb-4">
          Service Areas
        </p>
        <ul class="space-y-2" role="list">
          {footerServiceAreas.map((area) => (
            <li class="font-body text-sm text-surface/60">{area}</li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Wide thin map strip below the column row. Aspect-ratio caps height
         while letting the map go edge to edge of the footer container. -->
    <div class="mt-8 pb-8 border-b border-surface/10">
      <div class="flex items-center justify-between gap-4 mb-3">
        <p class="font-body text-xs font-semibold tracking-widest uppercase text-surface/40">
          Find Us
        </p>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-tint hover:text-surface transition-colors"
        >
          Get directions
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
      <div
        id="footer-map"
        class="relative w-full aspect-[16/3] min-h-[110px] max-h-[180px] rounded-lg overflow-hidden ring-1 ring-surface/10 bg-surface/5"
      >
        <div class="absolute inset-0 flex items-center justify-center text-surface/40 text-xs">
          <span>Loading map…</span>
        </div>
      </div>
    </div>

    <!-- Bottom bar: copyright (left) + legal links (right) on lg, stacked
         on smaller screens. -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6">
      <p class="font-body text-xs text-surface/35">
        &copy; {year} {businessName}. All rights reserved.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        <a
          href="/privacy-policy"
          class="font-body text-xs text-surface/55 hover:text-surface transition-colors"
        >
          Privacy Policy
        </a>
        <a
          href="/terms-and-conditions"
          class="font-body text-xs text-surface/55 hover:text-surface transition-colors"
        >
          Terms and Conditions
        </a>
      </div>
    </div>

    <!-- Powered-by credit, centered. Links back to Review Harvest. -->
    <div class="flex justify-center pt-4 mt-4 border-t border-surface/10">
      <a
        href="https://reviewharvest.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-body text-xs text-surface/50 hover:text-surface transition-colors"
      >
        <span>Powered by</span>
        <span class="font-semibold">Review Harvest</span>
      </a>
    </div>

  </div>
</footer>

<script>
  import { siteInfo } from "@/lib/sdk";

  const container = document.getElementById("footer-map");
  if (container) {
    const { data, error } = await siteInfo.getMapUrl();

    if (error) {
      container.innerHTML = `<div class="absolute inset-0 flex items-center justify-center text-surface/40 text-sm"><span>${error.message}</span></div>`;
    } else if (data.mapUrl === null) {
      container.style.display = "none";
    } else {
      container.innerHTML = `<iframe title="Business location map" width="100%" height="100%" style="border:0; display:block; min-height:100%;" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" src="${data.mapUrl}"></iframe>`;
    }
  }
</script>
