---
/**
 * AccentField — a soft, slowly-drifting field of large background icons
 * used as a living section texture (the "icons as background accents"
 * move from the creative direction). Purely decorative.
 *
 * ── INTERCHANGEABLE PER SERVICE ──────────────────────────────────────
 * The icon set is meant to be swapped to match the vertical you're
 * building for. There are two ways to set it:
 *
 *   1. Globally (recommended): add an `accentIcons` array to
 *      src/data/business.ts, e.g.
 *          accentIcons: ["droplet", "spray", "house", "sparkle"]
 *      Every section that uses AccentField with no explicit `icons`
 *      prop will pick it up automatically.
 *
 *   2. Per-instance: pass `icons={[...]}` directly on the component.
 *
 * Keys must exist in ICON_REGISTRY below — add new paths there as the
 * library of verticals grows (roofing, lawn care, HVAC, etc.).
 *
 * Honors prefers-reduced-motion (icons hold still, no drift).
 * ─────────────────────────────────────────────────────────────────────
 */
import { business } from "@/data/business";

interface Props {
  /** Icon keys from ICON_REGISTRY. Falls back to business.accentIcons,
   *  then a generic home-service set. */
  icons?: string[];
  /** Color tone, pick the one that contrasts the section background.
   *  brand → faint brand color (good on light backgrounds)
   *  dark  → faint near-black (good on light/tinted backgrounds)
   *  light → faint white (good on brand / dark backgrounds) */
  tone?: "brand" | "dark" | "light";
  /** Extra classes on the wrapper (rarely needed). */
  class?: string;
}

/** Outline icon paths (24x24 viewBox, stroke style). */
const ICON_REGISTRY: Record<string, string> = {
  spray:   "M12 3v3m0 12v3M5.636 5.636l2.122 2.122m8.485 8.485l2.122 2.122M3 12h3m12 0h3M5.636 18.364l2.122-2.122m8.485-8.485l2.122-2.122M9 12a3 3 0 116 0 3 3 0 01-6 0z",
  house:   "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h3v-6h6v6h3a1 1 0 001-1V10",
  roof:    "M2 12L12 4l10 8M5 11v9h14v-9",
  gutter:  "M3 7h18M5 7v6a4 4 0 004 4h6a4 4 0 004-4V7M9 17v4M15 17v4",
  wrench:  "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  shield:  "M9 12l2 2 4-4M12 2L4 6v6c0 5.5 3.84 10.74 8 12 4.16-1.26 8-6.5 8-12V6l-8-4z",
  droplet: "M12 3c3.5 4.5 6 7.5 6 11a6 6 0 11-12 0c0-3.5 2.5-6.5 6-11z",
  sparkle: "M12 2l2.2 5.8L20 10l-5.8 2.2L12 18l-2.2-5.8L4 10l5.8-2.2L12 2z",
  leaf:    "M4 20c2-6 6-9 10-11M5 21C5 11 11 5 21 5c0 10-6 16-16 16z",
  bubbles: "M7 14a4 4 0 100-8 4 4 0 000 8zm9 5a3 3 0 100-6 3 3 0 000 6zm1-9a2 2 0 100-4 2 2 0 000 4z",
  star:    "M11.48 3.5a.56.56 0 011.04 0l2.12 5.11 5.52.44a.56.56 0 01.32.98l-4.2 3.6 1.28 5.39a.56.56 0 01-.84.6L12 16.3l-4.72 2.83a.56.56 0 01-.84-.6l1.28-5.4-4.2-3.6a.56.56 0 01.32-.98l5.52-.44 2.12-5.1z",
  bolt:    "M13 2L4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5z",
};

const FALLBACK = ["spray", "house", "sparkle", "droplet", "wrench", "shield"];

const {
  icons = (business as { accentIcons?: string[] }).accentIcons ?? FALLBACK,
  tone = "brand",
  class: className = "",
} = Astro.props;

const toneClass =
  tone === "light" ? "text-brand-fg/10" : tone === "dark" ? "text-text/10" : "text-brand/10";

// Preset scatter slots: position, size, and per-icon drift timing so the
// field feels organic rather than synchronized. We cycle through these
// for however many icons are supplied.
const slots = [
  { top: "10%", left: "5%",  size: "w-16 h-16 lg:w-24 lg:h-24", dur: "13s", delay: "0s",   drift: "a" },
  { top: "60%", left: "10%", size: "w-20 h-20 lg:w-28 lg:h-28", dur: "17s", delay: "-4s",  drift: "b" },
  { top: "18%", left: "82%", size: "w-16 h-16 lg:w-24 lg:h-24", dur: "15s", delay: "-7s",  drift: "a" },
  { top: "68%", left: "78%", size: "w-16 h-16 lg:w-20 lg:h-20", dur: "19s", delay: "-2s",  drift: "b" },
  { top: "40%", left: "47%", size: "w-12 h-12 lg:w-16 lg:h-16", dur: "21s", delay: "-9s",  drift: "a" },
  { top: "84%", left: "42%", size: "w-16 h-16 lg:w-24 lg:h-24", dur: "16s", delay: "-5s",  drift: "b" },
  { top: "6%",  left: "44%", size: "w-12 h-12 lg:w-16 lg:h-16", dur: "18s", delay: "-11s", drift: "a" },
  { top: "46%", left: "90%", size: "w-12 h-12 lg:w-20 lg:h-20", dur: "14s", delay: "-3s",  drift: "b" },
];

const items = icons.map((key, i) => ({
  key,
  path: ICON_REGISTRY[key] ?? ICON_REGISTRY.sparkle,
  ...slots[i % slots.length],
}));
---

<div
  class:list={["pointer-events-none absolute inset-0 overflow-hidden", className]}
  aria-hidden="true"
>
  {items.map((it) => (
    <span
      class:list={["accent-ico absolute", it.size, toneClass]}
      style={`top:${it.top};left:${it.left};animation-duration:${it.dur};animation-delay:${it.delay};`}
      data-drift={it.drift}
    >
      <svg class="w-full h-full" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d={it.path} />
      </svg>
    </span>
  ))}
</div>

<style>
  /* Slow, looping drift so the section feels alive without pulling focus.
     Two named tracks (a / b) move in opposite directions; per-icon
     duration + negative delay (set inline) desyncs them. */
  .accent-ico {
    animation-name: accent-drift-a;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  .accent-ico[data-drift="b"] {
    animation-name: accent-drift-b;
  }
  @keyframes accent-drift-a {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50%      { transform: translate3d(0, -18px, 0) rotate(6deg); }
  }
  @keyframes accent-drift-b {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50%      { transform: translate3d(0, 16px, 0) rotate(-7deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .accent-ico {
      animation: none;
    }
  }
</style>
