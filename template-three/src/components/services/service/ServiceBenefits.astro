---
/**
 * ServiceBenefits, template-three variant: a blocky "benefit mosaic" — the
 * "why this matters to you" section, complementary to WhatsIncluded
 * ("what you get").
 *
 * Template-three reskin — deliberately distinct from the other two:
 *   - template-one  : photo + floating CIRCULAR portrait overlay on the
 *                     left, vertical stack of brand-color pill rows on the
 *                     right (mirrors TrustChecklist).
 *   - template-two  : centered editorial header + a clean 3-up grid of
 *                     small icon cards with italic-serif titles.
 *   - template-three: a MOSAIC grid. The first cell is a solid brand-deep
 *                     "anchor" block carrying the eyebrow + heading + a
 *                     blocky photo, sitting flush in the grid alongside the
 *                     benefit tiles. The remaining cells are blocky pop
 *                     benefit cards, each with a square brand icon tile and
 *                     a ghosted number. The header is NOT a separate
 *                     centered band — it lives IN the grid as the first
 *                     tile, so the whole section reads as one blocky wall.
 *
 * Reads `business.serviceDetails[N].benefits` (each benefit can carry its
 * own icon from the shared icon registry).
 */
import ImagePlaceholder from "@/components/ui/ImagePlaceholder.astro";

interface Benefit {
  title: string;
  description?: string;
  icon?: "shield" | "wrench" | "check" | "calendar" | "phone" | "quote";
}

interface Props {
  eyebrow?: string;
  serviceName: string;
  heading?: string;
  items: Benefit[];
}

const {
  eyebrow = "Why It Matters",
  serviceName,
  heading,
  items,
} = Astro.props;

const resolvedHeading = heading ?? `Why book ${serviceName}?`;

// Universal home-service icon registry, matches ProcessSteps so the
// visual vocabulary stays consistent across the site.
const iconPath: Record<NonNullable<Benefit["icon"]>, string> = {
  shield: "M9 12l2 2 4-4M12 2L4 6v6c0 5.5 3.84 10.74 8 12 4.16-1.26 8-6.5 8-12V6l-8-4z",
  wrench: "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  check: "M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  calendar: "M8 7V3m8 4V3M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  quote: "M3 5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM8 11h8M8 15h5",
};

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="bg-surface py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    {/* Anchor column (left) + benefit grid (right). The two outer columns
        stretch to equal height (items-stretch), and the benefits live in
        their own 2-up grid so an even set always lands symmetric with no
        orphan cell — 6 → a clean 2×3 block, 4 → 2×2. */}
    <div class="grid lg:grid-cols-3 gap-6 lg:gap-8 items-stretch">

      <!-- Anchor tile: eyebrow + heading + blocky photo -->
      <div
        class="lg:col-span-1 h-full bg-brand-deep text-brand-fg rounded-md shadow-pop p-7 lg:p-8 flex flex-col"
        data-reveal
        data-reveal-from="left"
      >
        {eyebrow && (
          <div class="inline-flex items-center gap-2.5 mb-4">
            <span class="block w-1.5 h-6 bg-brand-fg rounded-sm" aria-hidden="true"></span>
            <span class="font-heading font-semibold text-sm tracking-widest uppercase text-brand-fg/90">
              {eyebrow}
            </span>
          </div>
        )}

        <h2 class="font-heading font-extrabold text-3xl lg:text-4xl text-brand-fg leading-[1.1] tracking-tight">
          {resolvedHeading}
        </h2>

        {/* Blocky photo inside the anchor tile. On desktop it grows to
            fill the remaining column height (right up to the headline) so
            there's no blank orange gap; on mobile it stays a tall 4/5
            portrait. */}
        <div class="mt-7 aspect-[4/5] lg:aspect-auto lg:grow lg:min-h-0 lg:flex">
          <div class="w-full h-full rounded-md overflow-hidden ring-1 ring-brand-fg/20">
            <ImagePlaceholder
              aspect="fill"
              label="TECHNICIAN PHOTO"
              hint={`Technician performing ${serviceName.toLowerCase()}`}
              bloomPosition="tl"
            />
          </div>
        </div>
      </div>

      {/* Benefit tiles: their own 2-up grid spanning the right two columns. */}
      <ul
        class="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8"
        role="list"
      >
        {items.map((item, i) => (
          <li
            class="bg-bg rounded-md ring-1 ring-text/10 shadow-pop p-6 lg:p-7 flex flex-col transition-transform duration-150 hover:-translate-y-1"
            data-reveal
            data-reveal-from="up"
            data-reveal-delay={String(Math.min(i * 100, 700)) as "0" | "100" | "200" | "300" | "500" | "700"}
          >
            <div class="flex items-center justify-between mb-4">
              {/* Square brand-tint icon tile */}
              <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand-tint text-brand shadow-pop-sm shrink-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPath[item.icon ?? "check"]} />
                </svg>
              </span>
              <span class="font-heading font-extrabold text-3xl text-text/10 tabular-nums leading-none" aria-hidden="true">
                {pad(i)}
              </span>
            </div>

            <h3 class="font-heading font-bold text-lg lg:text-xl text-text leading-snug">
              {item.title}
            </h3>
            {item.description && (
              <p class="font-body text-sm text-text-soft mt-2 leading-relaxed flex-1">
                {item.description}
              </p>
            )}
          </li>
        ))}
      </ul>

    </div>

  </div>
</section>
