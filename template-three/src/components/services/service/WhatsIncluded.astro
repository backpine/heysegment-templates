---
/**
 * WhatsIncluded, template-three variant: blocky "pop checklist" of what's
 * actually delivered when the customer books this service.
 *
 * Template-three reskin — deliberately distinct from the other two
 * templates' service pages:
 *   - template-one  : left text + numbered cards, right tall photo with a
 *                     floating CIRCULAR "in-action" overlay.
 *   - template-two  : centered editorial header + 2-column hairline
 *                     numbered list + magazine footer photo.
 *   - template-three: a two-rail "ticket" layout. A sticky LEFT rail
 *                     carries the eyebrow + heading + a chunky brand count
 *                     badge + a blocky pop photo panel. The RIGHT rail is
 *                     a grid of blocky pop "check" cards, one per
 *                     inclusion, each anchored by a square brand icon tile
 *                     and a ghosted step number. No circular overlays, no
 *                     hairline editorial list — pure blocky pop language.
 *
 * A drifting AccentField gives the (light) section the living texture used
 * across the home page. Companion to ServiceBenefits — this section
 * answers "what do I get?" while ServiceBenefits answers "why does this
 * matter to me?".
 */
import ImagePlaceholder from "@/components/ui/ImagePlaceholder.astro";

interface Included {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  serviceName: string;
  heading?: string;
  subtext?: string;
  items: Included[];
  imageSrc?: string;
  imageAlt?: string;
  imageLabel?: string;
}

const {
  eyebrow = "What's Included",
  serviceName,
  heading,
  subtext,
  items,
  imageSrc,
  imageAlt = "Service in progress",
  imageLabel = "WORK PHOTO",
} = Astro.props;

const resolvedHeading = heading ?? `What ${serviceName} includes.`;
// Subtext is OPTIONAL on this section, the heading + count badge already
// explain what's included so we don't add filler text by default.
const resolvedSubtext = subtext;

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="bg-bg py-20 lg:py-28 relative">
  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">

      <!-- LEFT rail: eyebrow + heading + count badge + blocky photo -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        {eyebrow && (
          <div
            class="inline-flex items-center gap-2.5 mb-4"
            data-reveal
            data-reveal-from="left"
          >
            <span class="block w-1.5 h-6 bg-brand rounded-sm" aria-hidden="true"></span>
            <span class="font-heading font-semibold text-sm tracking-widest uppercase text-brand">
              {eyebrow}
            </span>
          </div>
        )}

        <h2
          class="font-heading font-extrabold text-3xl lg:text-4xl text-text leading-[1.1] tracking-tight mb-5"
          data-reveal
          data-reveal-from="left"
          data-reveal-delay="100"
        >
          {resolvedHeading}
        </h2>

        {resolvedSubtext && (
          <p
            class="font-body text-base text-text-soft leading-relaxed mb-6 max-w-md"
            data-reveal
            data-reveal-from="left"
            data-reveal-delay="200"
          >
            {resolvedSubtext}
          </p>
        )}

        {/* Chunky brand count badge — "X things, every time" */}
        <div
          class="inline-flex items-center gap-3 bg-brand text-brand-fg rounded-md shadow-pop px-5 py-3.5 mb-8"
          data-reveal
          data-reveal-from="left"
          data-reveal-delay="200"
        >
          <span class="font-heading font-extrabold text-3xl leading-none tabular-nums">
            {items.length}
          </span>
          <span class="font-heading font-semibold text-sm leading-tight max-w-[14ch]">
            things done right, every visit
          </span>
        </div>

        {/* Blocky pop photo panel — hard edges, offset shadow */}
        <div
          class="rounded-md overflow-hidden ring-1 ring-text/10 shadow-pop"
          data-reveal
          data-reveal-from="left"
          data-reveal-delay="300"
        >
          <ImagePlaceholder
            aspect="4/3"
            imageSrc={imageSrc}
            imageAlt={imageAlt}
            label={imageLabel}
            hint="Service in action photo"
            bloomPosition="br"
          />
        </div>
      </div>

      <!-- RIGHT rail: grid of blocky pop "check" cards, one per inclusion -->
      <div class="lg:col-span-7">
        <ol class="grid grid-cols-1 sm:grid-cols-2 gap-5 lg:gap-6" role="list">
          {items.map((item, i) => (
            <li
              class="relative bg-surface rounded-md ring-1 ring-text/10 shadow-pop p-6 lg:p-7 transition-transform duration-150 hover:-translate-y-1"
              data-reveal
              data-reveal-from="up"
              data-reveal-delay={String(Math.min(i * 100, 700)) as "0" | "100" | "200" | "300" | "500" | "700"}
            >
              <div class="flex items-center justify-between mb-4">
                {/* Square brand check tile */}
                <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand text-brand-fg shadow-pop-sm shrink-0">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                {/* Ghosted step number */}
                <span class="font-heading font-extrabold text-4xl text-text/10 tabular-nums leading-none" aria-hidden="true">
                  {pad(i)}
                </span>
              </div>

              <h3 class="font-heading font-bold text-lg lg:text-xl text-text leading-snug">
                {item.title}
              </h3>
              <p class="font-body text-sm text-text-soft mt-2 leading-relaxed">
                {item.description}
              </p>
            </li>
          ))}
        </ol>
      </div>

    </div>
  </div>
</section>
