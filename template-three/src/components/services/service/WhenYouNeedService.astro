---
/**
 * WhenYouNeedService, template-three variant: a DARK "is this you?" band
 * of blocky scenario cards that walks through the situations that should
 * prompt the customer to book this service.
 *
 * Template-three reskin — deliberately distinct from the other two:
 *   - template-one / template-two : a narrow (max-w-4xl) centered editorial
 *                     header + a single vertical list of scenario rows with
 *                     HAIRLINE dividers, circular icon discs, a small "0X"
 *                     editorial number, and a centered CTA pair at the end.
 *   - template-three: a full-width DARK (bg-text) band — the rhythm break
 *                     between the two light sections around it — with a
 *                     responsive GRID of blocky pop scenario cards. Each
 *                     card carries a square brand icon tile, a ghosted
 *                     number, and uses the orange offset "pop-brand"
 *                     shadow that reads on dark backgrounds. The closing
 *                     CTA pair sits inside a chunky inline bar, not a
 *                     centered stack.
 *
 * The dark band gives the service-detail page a strong light → DARK →
 * light cadence (WhatsIncluded → WhenYouNeed → ServiceBenefits), matching
 * the home page's TestimonialsTeal dark interlude.
 */
import { business } from "@/data/business";

interface Scenario {
  title: string;
  description: string;
  icon?: "shield" | "wrench" | "check" | "calendar" | "phone" | "quote";
}

interface Props {
  eyebrow?: string;
  serviceName: string;
  heading?: string;
  /** Accent lead sentence shown beneath the heading. */
  accent?: string;
  /** Body paragraph below the lead. */
  lead?: string;
  scenarios: Scenario[];
  primaryCta?: { label: string; href: string };
}

const phoneHref = "tel:+1" + business.phone.replace(/\D/g, "");

const {
  eyebrow = "When You Need It",
  serviceName,
  heading,
  accent,
  lead,
  scenarios,
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
} = Astro.props;

const resolvedHeading = heading ?? `When do you need ${serviceName}?`;
const resolvedAccent =
  accent ?? `If any of this sounds familiar, it's time.`;

// Universal home-service icon registry, matches ProcessSteps so the
// visual vocabulary stays consistent across the site.
const iconPath: Record<NonNullable<Scenario["icon"]>, string> = {
  quote: "M3 5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM8 11h8M8 15h5",
  calendar: "M8 7V3m8 4V3M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  check: "M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  wrench: "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  shield: "M9 12l2 2 4-4M12 2L4 6v6c0 5.5 3.84 10.74 8 12 4.16-1.26 8-6.5 8-12V6l-8-4z",
};

const pad = (n: number) => String(n + 1).padStart(2, "0");
---

<section class="bg-text text-surface py-20 lg:py-28 relative overflow-hidden">

  {/* Faint icon-accent texture for the dark band */}
  <div class="absolute inset-0 bg-accent-dots-light opacity-60 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Header -->
    <div class="max-w-3xl mb-12 lg:mb-16">
      {eyebrow && (
        <div
          class="inline-flex items-center gap-2.5 mb-4"
          data-reveal
          data-reveal-from="left"
        >
          <span class="block w-1.5 h-6 bg-brand rounded-sm" aria-hidden="true"></span>
          <span class="font-heading font-semibold text-sm tracking-widest uppercase text-brand">
            {eyebrow}
          </span>
        </div>
      )}

      <h2
        class="font-heading font-extrabold text-3xl lg:text-5xl text-surface leading-[1.1] tracking-tight"
        data-reveal
        data-reveal-from="left"
        data-reveal-delay="100"
      >
        {resolvedHeading}
      </h2>

      {resolvedAccent && (
        <p
          class="font-heading font-semibold text-xl lg:text-2xl text-brand mt-4 leading-snug"
          data-reveal
          data-reveal-from="left"
          data-reveal-delay="200"
        >
          {resolvedAccent}
        </p>
      )}

      {lead && (
        <p
          class="font-body text-base lg:text-lg text-surface/70 mt-5 leading-relaxed max-w-2xl"
          data-reveal
          data-reveal-from="left"
          data-reveal-delay="300"
        >
          {lead}
        </p>
      )}
    </div>

    <!-- Grid of blocky pop scenario cards (orange offset shadow on dark) -->
    <ul
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8"
      role="list"
    >
      {scenarios.map((scenario, i) => (
        <li
          class="bg-surface text-text rounded-md shadow-pop-brand p-6 lg:p-7 flex flex-col transition-transform duration-150 hover:-translate-y-1"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay={String(Math.min(i * 100, 700)) as "0" | "100" | "200" | "300" | "500" | "700"}
        >
          <div class="flex items-center justify-between mb-5">
            {/* Square brand icon tile */}
            <span class="inline-flex items-center justify-center w-14 h-14 rounded-md bg-brand-tint text-brand shrink-0">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={iconPath[scenario.icon ?? "check"]} />
              </svg>
            </span>
            {/* Ghosted number */}
            <span class="font-heading font-extrabold text-5xl text-text/10 tabular-nums leading-none" aria-hidden="true">
              {pad(i)}
            </span>
          </div>

          <h3 class="font-heading font-bold text-lg lg:text-xl text-text leading-snug">
            {scenario.title}
          </h3>
          <p class="font-body text-sm lg:text-base text-text-soft mt-2.5 leading-relaxed flex-1">
            {scenario.description}
          </p>
        </li>
      ))}
    </ul>

    <!-- Closing CTA bar: chunky inline pop, not a centered stack -->
    <div
      class="mt-12 lg:mt-14 bg-brand text-brand-fg rounded-md shadow-pop-brand p-6 lg:p-8 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6"
      data-reveal
      data-reveal-from="up"
    >
      <div>
        <p class="font-heading font-extrabold text-xl lg:text-2xl leading-tight">
          Sound familiar?
        </p>
        <p class="font-body text-sm lg:text-base text-brand-fg/85 mt-1.5 max-w-xl leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 shrink-0">
        <a
          href={primaryCta.href}
          class="btn-pop inline-flex items-center justify-center gap-2 bg-surface text-text font-heading font-semibold text-base px-7 py-3.5 rounded-pill hover:bg-brand-tint whitespace-nowrap"
        >
          {primaryCta.label}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href={phoneHref}
          class="btn-pop inline-flex items-center justify-center gap-2 bg-brand-deep text-brand-fg font-heading font-semibold text-base px-7 py-3.5 rounded-pill hover:bg-text whitespace-nowrap"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
          </svg>
          Call {business.phone}
        </a>
      </div>
    </div>

  </div>
</section>
