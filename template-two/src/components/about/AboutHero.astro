---
/**
 * AboutHero — dark page-header for /about.
 *
 * Template-two: thin wrapper around the shared PageHero that computes
 * the local-SEO H1 pill ("About [Business] in [City, State]").
 * Structure lives in PageHero so this hero rhythms with every page.
 */
import { business } from "@/data/business";
import PageHero from "@/components/global/PageHero.astro";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  tagline?: string;
  subtext?: string;
  primaryCta?: { label: string; href: string };
  breadcrumbs?: Crumb[];
}

const city = business.address?.city;
const state = business.address?.state;
const cityState = state ? `${city}, ${state}` : city ?? "Your Area";

const {
  tagline = "Lorem ipsum dolor sit amet.",
  subtext,
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  breadcrumbs,
} = Astro.props;

const h1Pill = `About ${business.name} in ${cityState}`;
---

<PageHero
  h1Pill={h1Pill}
  tagline={tagline}
  subtext={subtext}
  primaryCta={primaryCta}
  breadcrumbs={breadcrumbs}
  backgroundImage="https://picsum.photos/seed/about-hero/1920/1080"
  placeholderLabel="ABOUT PAGE BACKGROUND"
  placeholderHint="Wide hero photo, owner / team shot or branded vehicle"
/>
