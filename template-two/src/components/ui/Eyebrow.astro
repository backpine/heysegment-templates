---
/**
 * Eyebrow — small label that sits above headlines.
 *
 * Template-two variant. Same prop API as template-one's Eyebrow so the
 * two templates share an identical component architecture, but the
 * visual treatment follows template-two's editorial / gold identity:
 *
 *   pill   , solid gold pill with light text and a soft shadow. Used
 *            as the page H1 in the dark hero pattern (pass `as="h1"`)
 *            and as a chip/badge label elsewhere.
 *
 *   line   , a short brand-color line + small uppercase brand-text
 *            label. When `align="center"` the line renders on BOTH
 *            sides (── LABEL ──) to match template-two's centered
 *            section eyebrows; left-aligned shows a single leading
 *            line.
 *
 * The `as` prop lets the call-site choose the underlying element so
 * the component fits both heading (h1/h2) and inline (p/span/div) uses
 * without duplicating markup.
 */
interface Props {
  label: string;
  variant?: "pill" | "line";
  /** Underlying element. Defaults: pill → "h1", line → "p". */
  as?: "h1" | "h2" | "h3" | "p" | "div" | "span";
  /** Text alignment for the wrapper. Only meaningful for the line variant. */
  align?: "left" | "center";
  class?: string;
}

const {
  label,
  variant = "pill",
  align = "left",
  class: className,
} = Astro.props;

const Tag = Astro.props.as ?? (variant === "pill" ? "h1" : "p");

const pillClasses =
  "inline-block bg-brand text-surface font-body font-bold text-xs sm:text-sm tracking-widest uppercase px-5 py-2.5 rounded-pill shadow-md";

const lineWrapperClasses = [
  "inline-flex items-center gap-2.5",
  align === "center" ? "justify-center" : "",
].filter(Boolean).join(" ");
---

{variant === "pill" ? (
  <Tag class:list={[pillClasses, className]}>{label}</Tag>
) : (
  <Tag class:list={[lineWrapperClasses, className]}>
    <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
    <span class="font-body text-sm font-bold tracking-widest uppercase text-brand">{label}</span>
    {align === "center" && <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>}
  </Tag>
)}
