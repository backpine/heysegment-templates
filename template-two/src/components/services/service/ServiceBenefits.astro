---
/**
 * ServiceBenefits, template-two variant: 3-column editorial benefit
 * cards with icon + italic-serif title + description (the "why this
 * matters" angle, complementary to WhatsIncluded's "what you get").
 *
 * Distinct from template-one's pattern (which mirrored the photo +
 * pill-stack treatment of TrustChecklist). Template-two's TrustChecklist
 * already does the magazine-style photo + numbered list — so
 * ServiceBenefits takes a DIFFERENT shape: clean 3-up grid of small
 * editorial cards, each anchored by a brand-tint icon disc and a short
 * italic-serif title with a brief description below. Mirrors the
 * WhatMakesUsDifferent rhythm but tighter (smaller cards, no zigzag).
 *
 * Reads `business.serviceDetails[N].benefits` (each benefit can have
 * its own icon from the shared icon registry).
 */

interface Benefit {
  title: string;
  description?: string;
  icon?: "shield" | "wrench" | "check" | "calendar" | "phone" | "quote";
}

interface Props {
  eyebrow?: string;
  serviceName: string;
  heading?: string;
  items: Benefit[];
}

const {
  eyebrow = "Why It Matters",
  serviceName,
  heading,
  items,
} = Astro.props;

const resolvedHeading = heading ?? `Why book ${serviceName}?`;

// Universal home-service icon registry, matches ProcessSteps so the
// visual vocabulary stays consistent across the site.
const iconPath: Record<NonNullable<Benefit["icon"]>, string> = {
  shield: "M9 12l2 2 4-4M12 2L4 6v6c0 5.5 3.84 10.74 8 12 4.16-1.26 8-6.5 8-12V6l-8-4z",
  wrench: "M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z",
  check: "M9 12l2 2 4-4M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  calendar: "M8 7V3m8 4V3M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z",
  phone: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z",
  quote: "M3 5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2H5a2 2 0 01-2-2V5zM8 11h8M8 15h5",
};
---

<section class="bg-surface py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">

    <!-- Centered editorial header -->
    <div class="max-w-3xl mx-auto text-center mb-14 lg:mb-16">
      {eyebrow && (
        <div
          class="inline-flex items-center justify-center gap-2.5 mb-4"
          data-reveal
          data-reveal-from="up"
        >
          <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
          <span class="font-body text-sm font-bold tracking-widest uppercase text-brand">
            {eyebrow}
          </span>
          <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
        </div>
      )}

      <h2
        class="font-heading italic font-medium text-3xl lg:text-5xl text-text leading-[1.1]"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        {resolvedHeading}
      </h2>
    </div>

    <!-- 3-column editorial benefit cards. Tighter than
         WhatMakesUsDifferent (which is full-width zigzag rows) so the
         two sections feel related but distinct. Each card: brand-tint
         icon disc + italic-serif title + brief description. -->
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6"
      role="list"
    >
      {items.map((item, i) => (
        <li
          class="bg-bg ring-1 ring-border rounded-md p-6 lg:p-7 hover:ring-brand/40 hover:shadow-md transition-all"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay={String(Math.min(i * 75, 525)) as "0" | "75" | "150" | "225" | "300" | "375" | "450" | "525"}
        >
          <!-- Icon disc, brand-tint -->
          <span class="inline-flex items-center justify-center w-12 h-12 rounded-md bg-brand-tint text-brand ring-1 ring-brand/20 mb-4">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPath[item.icon ?? "check"]} />
            </svg>
          </span>

          <h3 class="font-heading italic font-medium text-lg lg:text-xl text-text leading-snug mb-2">
            {item.title}
          </h3>
          {item.description && (
            <p class="font-body text-sm text-text-soft leading-relaxed">
              {item.description}
            </p>
          )}
        </li>
      ))}
    </ul>

  </div>
</section>
