---
/**
 * ServiceDetailHero — dark page-header for /services/[slug].
 *
 * Template-two: thin wrapper around the shared PageHero that:
 *   - Computes the local-SEO H1 pill ("[Service] in [City, State]")
 *   - Forwards the optional 4-up keyPoints checklist
 *   - Carries the service-page placeholder hint + seeded photo
 *
 * All structure (centered layout, italic-serif tagline, overlay,
 * breadcrumbs-inside, dual CTA) lives in PageHero so this hero rhythms
 * with every other page.
 */
import { business } from "@/data/business";
import PageHero from "@/components/global/PageHero.astro";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  serviceName: string;
  tagline?: string;
  subtext?: string;
  keyPoints?: string[];
  primaryCta?: { label: string; href: string };
  breadcrumbs?: Crumb[];
}

const city = business.address?.city;
const state = business.address?.state;
const cityState = state ? `${city}, ${state}` : city ?? "Your Area";

const {
  serviceName,
  tagline = "Lorem ipsum dolor sit amet.",
  subtext,
  keyPoints = [],
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  breadcrumbs,
} = Astro.props;

const h1Pill = `${serviceName} in ${cityState}`;
---

<PageHero
  h1Pill={h1Pill}
  tagline={tagline}
  subtext={subtext}
  keyPoints={keyPoints}
  primaryCta={primaryCta}
  breadcrumbs={breadcrumbs}
  backgroundImage="https://picsum.photos/seed/service-detail-hero/1920/1080"
  placeholderLabel="SERVICE PAGE BACKGROUND"
  placeholderHint="Wide hero photo, technician performing this specific service"
/>
