---
/**
 * ServiceAreaHero — dark page-header for /service-area/[slug].
 *
 * Template-two: thin wrapper around the shared PageHero that computes
 * the local-SEO H1 pill ("[Primary Service] in [City, State]") and
 * forwards the optional key-points checklist. Structure lives in
 * PageHero so this hero rhythms with every other page.
 */
import { business } from "@/data/business";
import PageHero from "@/components/global/PageHero.astro";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  cityName: string;
  tagline?: string;
  keyPoints?: string[];
  primaryCta?: { label: string; href: string };
  breadcrumbs?: Crumb[];
}

const state = business.address?.state;
const primaryCategory = business.services.find((s) => s.tier === "category")?.name ?? "Home Service";

const {
  cityName,
  tagline = "Lorem ipsum dolor sit amet.",
  keyPoints = [],
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  breadcrumbs,
} = Astro.props;

const cityState = state ? `${cityName}, ${state}` : cityName;
const h1Pill = `${primaryCategory} in ${cityState}`;
---

<PageHero
  h1Pill={h1Pill}
  tagline={tagline}
  keyPoints={keyPoints}
  primaryCta={primaryCta}
  breadcrumbs={breadcrumbs}
  backgroundImage="https://picsum.photos/seed/service-area-hero/1920/1080"
  placeholderLabel="SERVICE AREA BACKGROUND"
  placeholderHint={`Wide hero photo, ${cityName} skyline / neighborhood / branded vehicle`}
/>
