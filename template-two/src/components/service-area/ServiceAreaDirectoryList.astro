---
/**
 * ServiceAreaDirectoryList — full directory of every city we cover.
 *
 * Template-two: cream-bg editorial list of alternating photo + content
 * rows, identical visual treatment to ServiceDirectoryList (both
 * render via the shared DirectoryCard). The two directory pages read
 * as siblings, just scoped to cities vs services.
 *
 * Reads `business.locations`. Neighborhoods render as the chip preview
 * (capped, with a "+ N more" indicator), mirroring how the services
 * directory shows sub-services.
 */
import { business } from "@/data/business";
import DirectoryCard from "@/components/global/DirectoryCard.astro";

interface LocationRow {
  name: string;
  slug: string;
  tagline?: string;
  intro?: string;
  neighborhoods?: string[];
}

interface Props {
  eyebrow?: string;
  heading?: string;
  subtext?: string;
  /** Compatibility prop from template-one's API. No-op in template-two
   *  (which has no wave dividers). */
  bottomTransition?: "brand" | "bg" | "none";
  /** Cap the number of neighborhood chips shown per row. */
  neighborhoodPreviewLimit?: number;
}

const rows: LocationRow[] = business.locations.map((l) => ({
  name: l.name,
  slug: l.slug,
  tagline: l.tagline,
  intro: l.intro,
  neighborhoods: l.neighborhoods,
}));

const {
  eyebrow = "Our Coverage Map",
  heading = "Every area we serve.",
  subtext = "Tap any city to see local reviews, projects, and the services we offer there. Don't see your area? Give us a call, we may still cover you.",
  neighborhoodPreviewLimit = 4,
} = Astro.props;
---

<section class="bg-bg py-20 lg:py-28">
  <div class="max-w-6xl mx-auto px-6 lg:px-10">

    <!-- Centered editorial header -->
    <div class="max-w-3xl mx-auto text-center mb-16 lg:mb-20">
      {eyebrow && (
        <div
          class="inline-flex items-center justify-center gap-2.5 mb-4"
          data-reveal
          data-reveal-from="up"
        >
          <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
          <span class="font-body text-sm font-bold tracking-widest uppercase text-brand">
            {eyebrow}
          </span>
          <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
        </div>
      )}
      <h2
        class="font-heading italic font-medium text-3xl lg:text-5xl text-text leading-[1.1]"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        {heading}
      </h2>
      {subtext && (
        <p
          class="font-body text-base lg:text-lg text-text-soft mt-5 leading-relaxed max-w-2xl mx-auto"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay="200"
        >
          {subtext}
        </p>
      )}
    </div>

    <!-- Alternating photo + content rows (zigzag), each via DirectoryCard -->
    <ol class="space-y-16 lg:space-y-24" role="list">
      {rows.map((row, i) => {
        const previewHoods = (row.neighborhoods ?? []).slice(0, neighborhoodPreviewLimit);
        const restCount = (row.neighborhoods?.length ?? 0) - previewHoods.length;
        return (
          <DirectoryCard
            index={i}
            eyebrowLabel="Service Area"
            name={row.name}
            body={row.intro ?? row.tagline ?? ""}
            imageHint={`Wide shot of ${row.name}`}
            chipsHeading={previewHoods.length > 0 ? "Neighborhoods" : undefined}
            chips={previewHoods}
            chipsRestCount={restCount}
            primaryCta={{ label: "Learn More", href: `/service-area/${row.slug}` }}
          />
        );
      })}
    </ol>

  </div>
</section>
