---
/**
 * FinalCTA, template-two variant.
 *
 * Full-bleed DARK NAVY closer (vs template-one's bg-brand teal). With
 * template-two's brand color now being warm gold, a gold full-bleed
 * would feel overwhelming, so we move the section to dark navy and
 * use gold sparingly as the primary CTA accent. Sits just above the
 * footer on every page, ends the page with one clear ask.
 *
 * Key visual differences from template-one:
 *   - Section bg = dark navy (bg-text), not brand gold
 *   - Heading = italic display serif (Fraunces) for editorial luxury feel
 *   - Primary CTA = gold pill (bg-brand) with navy text — pops on dark
 *   - Secondary CTA = outlined white pill, click-to-call
 *   - Optional photo background uses navy/85 overlay (not gold/85)
 *   - Decorative ambient glow uses brand color (gold) at low opacity
 */
import { business } from "@/data/business";

interface Props {
  eyebrow?: string | null;
  heading?: string;
  subtext?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string } | null;
  backgroundImage?: string | null;
  /** Compress the section's TOP padding so this CTA reads as one
   *  continuous block with the section above (when both are dark
   *  navy), instead of leaving a tall empty void between them. */
  tightTop?: boolean;
}

const phoneHref = "tel:+1" + business.phone.replace(/\D/g, "");

const {
  eyebrow = business.identityBadge?.short ?? "Let's Get Started",
  heading = `Ready to work with ${business.name}?`,
  subtext = "Free quotes. Honest pricing. Real people answering the phone. Tell us what you need and we'll take it from there.",
  primaryCta = { label: business.ctaLabel, href: "/contact" },
  secondaryCta = { label: `Call ${business.phone}`, href: phoneHref },
  /* Default background photo so the closer matches the rest of the
     site's hero-style imagery. Swap for the brand's own photo when
     ready by passing a `backgroundImage` prop. */
  backgroundImage = "https://picsum.photos/seed/template-two-final-cta/1920/1080",
  tightTop = false,
} = Astro.props;
---

<section
  class="relative bg-text text-surface overflow-hidden"
  aria-label="Final call to action"
>
  {/* Background image with a navy overlay. The overlay uses a vertical
      gradient (top: 80% navy → bottom: 100% solid navy) so the section
      visually FADES INTO THE FOOTER below — both end up rendering
      identical solid navy at the join, no harsh divider line between
      the FinalCTA and the footer. The footer is bg-text (dark navy),
      so the gradient's bottom stop matches it pixel-for-pixel. */}
  {backgroundImage && (
    <div class="absolute inset-0 z-0" aria-hidden="true">
      <img
        src={backgroundImage}
        alt=""
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-text/80 via-text/85 to-text"></div>
    </div>
  )}

  {/* Decorative ambient glow, subtle gold radial highlight. HIDDEN when
      tightTop is set so the dark-navy band reads as one continuous
      block with the section above (e.g. TestimonialsTeal on /about). */}
  {!tightTop && (
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[1100px] h-[600px] rounded-full bg-brand/10 blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>
  )}

  <div class:list={[
    "relative z-10 max-w-5xl mx-auto px-6 lg:px-10 text-center",
    tightTop ? "pt-10 lg:pt-14 pb-20 lg:pb-28" : "py-20 lg:py-28",
  ]}>

    {eyebrow && (
      <div class="inline-flex items-center justify-center gap-2.5 mb-5">
        <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
        <span class="font-body text-sm font-semibold tracking-widest uppercase text-brand">
          {eyebrow}
        </span>
        <span class="block w-5 h-px bg-brand" aria-hidden="true"></span>
      </div>
    )}

    <h2 class="font-heading italic font-medium text-3xl sm:text-4xl lg:text-5xl text-surface leading-tight max-w-3xl mx-auto">
      {heading}
    </h2>

    {subtext && (
      <p class="font-body text-base lg:text-lg text-surface/85 mt-5 leading-relaxed max-w-xl mx-auto">
        {subtext}
      </p>
    )}

    <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center justify-center gap-3 sm:gap-4 mt-10">
      <!-- Primary CTA: GOLD pill on dark navy -->
      <a
        href={primaryCta.href}
        class="inline-flex items-center justify-center gap-2 bg-brand text-brand-fg font-body font-bold text-base px-8 py-4 rounded-pill shadow-lg hover:bg-brand-deep hover:shadow-xl hover:scale-[1.02] transition-all"
      >
        {primaryCta.label}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.75" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>

      <!-- Secondary CTA: outlined white pill, click-to-call. -->
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-flex items-center justify-center gap-2 bg-transparent text-surface ring-2 ring-surface/70 font-body font-bold text-base px-8 py-4 rounded-pill hover:bg-surface hover:text-text transition-colors whitespace-nowrap"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
          </svg>
          {secondaryCta.label}
        </a>
      )}
    </div>

  </div>
</section>
