---
/**
 * Hero — home page header (template-two).
 *
 * Thin wrapper around the shared PageHero. Centered, single gold CTA,
 * no breadcrumbs (it's the home page). The quote form is NOT in the
 * hero — it lives in the standalone QuickFormBar that sits directly
 * below this hero and sticks on scroll, so the hero stays minimal.
 *
 * h1Pill defaults to the local-SEO "[City, State]'s Top Rated
 * [Service]" pattern; tagline is the big italic-serif centerpiece.
 */
import { business } from "@/data/business";
import PageHero from "@/components/global/PageHero.astro";

interface Props {
  h1Pill?: string;
  tagline?: string;
  subtext?: string;
  primaryCta?: { label: string; href: string };
  backgroundImage?: string | null;
}

const primaryCategory = business.services.find((s) => s.tier === "category");
const city = business.address?.city;
const state = business.address?.state;

const defaultH1Service = primaryCategory?.name ?? "Premium Service";
const cityState = state ? `${city}, ${state}` : city ?? "Your Area";
const defaultH1Pill = `${cityState}'s Top Rated ${defaultH1Service}`;

const {
  h1Pill = defaultH1Pill,
  tagline = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
  subtext,
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  backgroundImage = "https://picsum.photos/seed/template-two-home/1920/1080",
} = Astro.props;
---

<PageHero
  h1Pill={h1Pill}
  tagline={tagline}
  subtext={subtext}
  primaryCta={primaryCta}
  secondaryCta={false}
  backgroundImage={backgroundImage}
  placeholderLabel="HERO BACKGROUND"
  placeholderHint="Wide hero photo, signature project at golden-hour or twilight"
/>
