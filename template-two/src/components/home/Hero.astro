---
/**
 * Hero, template-two variant.
 *
 * Centered, sleek, premium-luxury feel inspired by the Lumos / high-end
 * outdoor lighting layout. Differs from template-one's hero in three
 * structural ways:
 *
 *   1. CENTERED layout (template-one is left-aligned 7/5 split).
 *      Headline, subhead, and primary CTA all stack vertically and
 *      align to the page's horizontal center.
 *
 *   2. SINGLE primary CTA pill (template-one stacks a form on the
 *      right). The form moves to its own compact "quick form" strip
 *      directly under the CTA — three short fields + submit, "Takes
 *      Only 5 Seconds" framing.
 *
 *   3. NO trust-marker checklist row (template-one has the 4-up
 *      checkmark grid). The trust signals move to a stat strip
 *      further down the page so the hero stays minimal.
 *
 * Visual identity carries through: italic display-serif heading
 * (Fraunces) sits centered on a dark-navy + cream gradient or photo
 * background.
 */
import { business } from "@/data/business";

interface Props {
  /** H1 (rendered as a compact pill). */
  h1Pill?: string;
  /** Big visual italic-serif tagline beneath the H1. */
  tagline?: string;
  /** Short subhead below the tagline. */
  subtext?: string;
  primaryCta?: { label: string; href: string };
  backgroundImage?: string | null;
  /** Show the compact "quick form" strip directly under the CTA. */
  showQuickForm?: boolean;
  /** Form post target, defaults to "#". */
  formAction?: string;
  /** Placeholder note shown when no backgroundImage is supplied. */
  placeholderHint?: string;
}

const primaryCategory = business.services.find((s) => s.tier === "category");
const city = business.address?.city;
const state = business.address?.state;

const defaultH1Service = primaryCategory?.name ?? "Premium Service";
const cityState = state ? `${city}, ${state}` : city ?? "Your Area";
const defaultH1Pill = `${cityState}'s Top Rated ${defaultH1Service}`;

const {
  h1Pill = defaultH1Pill,
  tagline = "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
  subtext,
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  /* Default to a stable placeholder photo from picsum.photos so the
     hero feels like a real site out of the box (the user can swap to
     a real photo by passing their own `backgroundImage` URL). The
     `seed` keeps the image stable across reloads, so previewing the
     site doesn't shuffle the photo every time. */
  backgroundImage = "https://picsum.photos/seed/template-two-home/1920/1080",
  showQuickForm = true,
  formAction = "#",
  placeholderHint = "Wide hero photo, signature project at golden-hour or twilight",
} = Astro.props;
---

<section class="relative bg-text overflow-hidden isolate">

  {/* Background image OR placeholder */}
  {backgroundImage ? (
    <img
      src={backgroundImage}
      alt=""
      class="absolute inset-0 w-full h-full object-cover z-0"
      aria-hidden="true"
    />
  ) : (
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-text via-text to-brand-deep">
      <div class="absolute bottom-3 right-3 z-30 max-w-[260px] text-right">
        <p class="font-body text-[10px] uppercase tracking-widest text-surface/40">
          HERO BACKGROUND
        </p>
        <p class="font-body text-[11px] text-surface/40 mt-1 leading-snug">
          {placeholderHint}
        </p>
      </div>
    </div>
  )}

  {/* Dark gradient overlay so copy stays readable. CENTERED gradient
      (vs template-one's left-anchored gradient) so the focus stays
      pulled to the middle of the frame. */}
  <div
    class="absolute inset-0 z-10 bg-gradient-to-b from-text/90 via-text/65 to-text/85"
    aria-hidden="true"
  ></div>

  {/* Content, centered. */}
  <div class="relative z-20 max-w-7xl mx-auto px-6 lg:px-10 pt-40 lg:pt-48 pb-24 lg:pb-32 text-center">

    {/* H1 pill, centered. */}
    <h1
      class="inline-block bg-brand text-surface font-body font-bold text-xs sm:text-sm tracking-widest uppercase px-5 py-2.5 rounded-pill shadow-md mb-6"
      data-reveal
      data-reveal-from="up"
    >
      {h1Pill}
    </h1>

    {/* Display-serif italic tagline, the visual centerpiece. */}
    <p
      class="font-heading italic font-medium text-4xl sm:text-5xl lg:text-6xl text-surface leading-[1.05] tracking-tight max-w-4xl mx-auto"
      data-reveal
      data-reveal-from="up"
      data-reveal-delay="100"
    >
      {tagline}
    </p>

    {subtext && (
      <p
        class="font-body text-base lg:text-lg text-surface/80 mt-6 max-w-2xl mx-auto leading-relaxed"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="200"
      >
        {subtext}
      </p>
    )}

    {/* Primary CTA pill, single, centered. */}
    <div
      class="mt-10"
      data-reveal
      data-reveal-from="up"
      data-reveal-delay="300"
    >
      <a
        href={primaryCta.href}
        class="inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-deep text-surface font-body font-bold text-base lg:text-lg px-10 py-4 rounded-pill shadow-lg transition-all hover:shadow-xl hover:scale-[1.02]"
      >
        {primaryCta.label}
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
