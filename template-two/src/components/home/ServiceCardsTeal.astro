---
/**
 * ServiceCardsTeal, template-two variant: image-only service tiles
 * with hover overlay (Lumos pattern).
 *
 * Each tile is a single service photo. NO text underneath in the
 * default state — tiles read as a uniform aligned visual grid. On
 * hover/focus, a dark gold overlay fades in and reveals:
 *   - Service name
 *   - Short description
 *   - "Learn More" arrow link
 *
 * Section is smaller than the previous variant (less padding) so it
 * doesn't dominate the page. Centered editorial header at the top.
 *
 * Uses uniform aspect ratio (1:1 square) on every tile so the row is
 * perfectly aligned no matter what photos go in.
 *
 * Component name + props preserved so all consuming pages (services
 * detail cross-sell, service-area nearby grid) still work without
 * changes.
 */
import { business } from "@/data/business";
import ImagePlaceholder from "@/components/ui/ImagePlaceholder.astro";

interface Card {
  name: string;
  slug: string;
  icon?: string;
  description: string;
  href?: string;
  hint?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  cards?: Card[];
  ctaLabel?: string;
  ctaHref?: string;
  /** Compatibility props from template-one's API, no-ops here. */
  omitTopWave?: boolean;
  omitBottomWave?: boolean;
  omitCta?: boolean;
  tightBottom?: boolean;
}

const categories = business.services.filter((s) => s.tier === "category");

const TEASER_LIMIT = 3;

const {
  eyebrow,
  heading = `Our Core Services`,
  cards = categories.slice(0, TEASER_LIMIT).map((c) => ({
    name: c.name,
    slug: c.slug,
    icon: (c as { icon?: string }).icon,
    description: c.description,
  })),
  ctaLabel = "View All Services",
  ctaHref = "/services",
  omitCta = false,
  tightBottom = false,
} = Astro.props;

const gridColsClass =
  cards.length === 1
    ? "grid-cols-1 max-w-xs mx-auto"
    : cards.length === 2
    ? "grid-cols-1 sm:grid-cols-2 max-w-2xl mx-auto"
    : cards.length === 3
    ? "grid-cols-1 sm:grid-cols-3 max-w-4xl mx-auto"
    : "grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 max-w-5xl mx-auto";
---

<section
  class:list={[
    "bg-text text-surface relative",
    /* Smaller section padding than the previous variant (was py-20
       lg:py-28). Image-only tiles + hover-reveal carry less visual
       weight on their own, the section can breathe tighter. */
    tightBottom ? "pt-14 lg:pt-16 pb-6 lg:pb-8" : "py-14 lg:py-16",
  ]}
>
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Centered editorial header -->
    <div class="max-w-3xl mx-auto text-center mb-10 lg:mb-12">
      {eyebrow && (
        <p
          class="font-body text-sm font-bold tracking-widest uppercase text-brand mb-3"
          data-reveal
          data-reveal-from="up"
        >
          {eyebrow}
        </p>
      )}
      <h2
        class="font-heading italic font-medium text-3xl lg:text-4xl text-surface leading-[1.1]"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        {heading}
      </h2>
    </div>

    <!-- Image-only grid with hover-overlay reveal. Uniform 1:1 squares
         keep the row perfectly aligned. -->
    <ul
      class:list={["grid gap-4 lg:gap-5", gridColsClass]}
      role="list"
    >
      {cards.map((card, i) => (
        <li
          data-reveal
          data-reveal-from="up"
          data-reveal-delay={String(Math.min(i * 100, 300)) as "0" | "100" | "200" | "300"}
        >
          <a
            href={card.href ?? `/services/${card.slug}`}
            class="group relative block aspect-square overflow-hidden rounded-md ring-1 ring-surface/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-surface"
            aria-label={`${card.name}, learn more`}
          >
            <!-- The photo -->
            <ImagePlaceholder
              aspect="1/1"
              label={card.name.toUpperCase()}
              hint={card.hint ?? `Photo of ${card.name.toLowerCase()}`}
              bloomPosition={["tl", "tr", "bl", "br"][i % 4] as "tl" | "tr" | "bl" | "br"}
            />

            <!-- Always-visible bottom name (small, soft) so the tile
                 isn't a mystery before hover. Soft dark gradient
                 that doesn't fight the photo. -->
            <div class="absolute inset-x-0 bottom-0 z-10 p-4 bg-gradient-to-t from-text/75 via-text/35 to-transparent pointer-events-none">
              <p class="font-heading italic font-medium text-base lg:text-lg text-surface leading-tight">
                {card.name}
              </p>
            </div>

            <!-- Hover overlay: dark wash with full info, fades in -->
            <div class="absolute inset-0 z-20 bg-text/95 backdrop-blur-sm flex flex-col justify-center text-center p-6 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity duration-300">
              <h3 class="font-heading italic font-medium text-xl lg:text-2xl text-surface leading-tight mb-3">
                {card.name}
              </h3>
              <p class="font-body text-sm text-surface/85 leading-relaxed mb-5">
                {card.description}
              </p>
              <span class="inline-flex items-center justify-center gap-1.5 mx-auto font-body text-xs font-bold tracking-widest uppercase text-brand">
                Learn More
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA, "View All Services" -->
    {!omitCta && (
      <div class="mt-10 text-center" data-reveal data-reveal-from="up">
        <a
          href={ctaHref}
          class="inline-flex items-center gap-2 bg-brand hover:bg-brand-deep text-surface font-body font-bold text-sm tracking-widest uppercase px-7 py-3.5 rounded-pill transition-all hover:scale-[1.02]"
        >
          {ctaLabel}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    )}

  </div>
</section>
