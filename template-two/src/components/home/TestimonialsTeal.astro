---
/**
 * TestimonialsTeal, template-two variant: dark navy section with
 * centered editorial header and clean review cards. No wave dividers.
 *
 * Component name preserved so every existing page that imports
 * "TestimonialsTeal" keeps working without code changes; the visual
 * treatment is completely different from template-one's teal-bg
 * 3-up version with built-in wave dividers.
 *
 * Reads `business.reviews.items`. Default 3 reviews (overridable via
 * `reviews` prop), centered editorial header (italic serif heading),
 * clean white cards with quote-mark accent.
 */
import { business } from "@/data/business";
import StarRating from "@/components/ui/StarRating.astro";

interface Review {
  name: string;
  rating: number;
  text: string;
  subheading?: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  reviews?: Review[];
  ctaLabel?: string;
  ctaHref?: string;
  /** Compatibility props from template-one's API, no-ops here since
   *  template-two uses straight color bands instead of wave dividers. */
  omitTopWave?: boolean;
  omitBottomWave?: boolean;
  tightBottom?: boolean;
  bottomWaveBg?: "bg" | "surface";
  topWaveBg?: "bg" | "surface";
}

const {
  eyebrow = "What Our Clients Say",
  heading = "Don't take our word for it.",
  reviews = business.reviews.items.slice(0, 3),
  ctaLabel = "See All Reviews",
  ctaHref = "/reviews",
  tightBottom = false,
} = Astro.props;

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((n) => n[0])
    .join("")
    .toUpperCase()
    .slice(0, 2);
---

<section
  class:list={[
    "bg-text text-surface relative",
    tightBottom ? "pt-20 lg:pt-24 pb-10 lg:pb-14" : "py-20 lg:py-28",
  ]}
  aria-label="Customer reviews"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-10">

    <!-- Centered editorial header -->
    <div class="max-w-3xl mx-auto text-center mb-12 lg:mb-16">
      {eyebrow && (
        <p
          class="font-body text-sm font-bold tracking-widest uppercase text-brand mb-4"
          data-reveal
          data-reveal-from="up"
        >
          {eyebrow}
        </p>
      )}
      <h2
        class="font-heading italic font-medium text-3xl lg:text-5xl text-surface leading-[1.1]"
        data-reveal
        data-reveal-from="up"
        data-reveal-delay="100"
      >
        {heading}
      </h2>
    </div>

    <!-- Review cards, 3-up clean white -->
    <ul
      class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto"
      role="list"
    >
      {reviews.map((review, i) => (
        <li
          class="bg-surface text-text rounded-md shadow-md p-7 lg:p-8 flex flex-col"
          data-reveal
          data-reveal-from="up"
          data-reveal-delay={String(Math.min(i * 100, 300)) as "0" | "100" | "200" | "300"}
        >
          <!-- Big italic-serif quote-mark accent -->
          <span
            class="font-heading italic font-bold text-5xl text-brand leading-none mb-2 select-none"
            aria-hidden="true"
          >
            "
          </span>

          <!-- Quote -->
          <p class="font-body text-base text-text leading-relaxed flex-1">
            {review.text}
          </p>

          <!-- Footer: stars + name (no avatar) -->
          <div class="mt-6 pt-5 border-t border-border">
            <StarRating
              count={review.rating}
              class="flex gap-0.5 mb-2"
              starClass="w-4 h-4"
            />
            <p class="font-heading italic font-medium text-base text-text leading-tight">
              — {review.name}
            </p>
            {review.subheading && (
              <p class="font-body text-xs text-text-soft mt-0.5">
                {review.subheading}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 bg-brand hover:bg-brand-deep text-surface font-body font-bold text-sm tracking-widest uppercase px-8 py-4 rounded-pill shadow-lg transition-all hover:scale-[1.02]"
      >
        {ctaLabel}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

  </div>
</section>
