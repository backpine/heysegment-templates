---
/**
 * DirectoryCard — horizontal detail card used in the dark navy
 * directory lists (/services, /service-area).
 *
 * Both directories render the exact same horizontal-row card on a
 * dark navy bg: 16:9 image placeholder LEFT with a number badge and
 * an icon disc; on the RIGHT, an eyebrow + name + body copy + chip
 * list + dual CTA. The two pages differ only in the data they bind
 * (services vs cities) and a couple of labels (Includes vs
 * Neighborhoods, Service vs Service Area).
 *
 * Slots:
 *   default — overrides the body copy with custom markup if needed.
 */
import { business } from "@/data/business";
import ImagePlaceholder from "@/components/ui/ImagePlaceholder.astro";

interface Cta {
  label: string;
  href: string;
}

interface Props {
  /** 0-indexed position in the list. Drives the badge ("01", "02", …). */
  index: number;
  /** Small uppercase eyebrow above the name, e.g. "Service" / "Service Area". */
  eyebrowLabel: string;
  name: string;
  body: string;
  /** SVG path `d` for the icon shown in the bottom-right disc on the image. */
  iconPath: string;
  imageHint?: string;
  /** Optional chip list — heading + items (+ optional "rest count"). */
  chipsHeading?: string;
  chips?: string[];
  chipsRestCount?: number;
  primaryCta: Cta;
  /** Defaults to "Get a Free Quote" linking to business.ctaHref. */
  secondaryCta?: Cta;
  revealDelay?: "0" | "100" | "200" | "300";
}

const {
  index,
  eyebrowLabel,
  name,
  body,
  iconPath,
  imageHint,
  chipsHeading,
  chips = [],
  chipsRestCount = 0,
  primaryCta,
  secondaryCta = { label: "Get a Free Quote", href: business.ctaHref },
  revealDelay = "0",
} = Astro.props;

const padded = String(index + 1).padStart(2, "0");
---

<li class="group relative" data-reveal data-reveal-from="up" data-reveal-delay={revealDelay}>
  <article class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center bg-brand-fg/[0.04] hover:bg-brand-fg/[0.07] transition-colors rounded-2xl p-5 lg:p-7 ring-1 ring-brand-fg/10">

    <!-- LEFT: image placeholder with number badge + icon disc -->
    <div class="lg:col-span-5 relative">
      <ImagePlaceholder
        aspect="16/9"
        label={name.toUpperCase()}
        hint={imageHint}
        bloomPosition="tl"
      />
      <span
        class="absolute top-3 left-3 inline-flex items-center justify-center font-heading font-extrabold text-xs tracking-widest text-brand-fg bg-brand px-3 py-1.5 rounded-full shadow-md"
        aria-hidden="true"
      >
        {padded}
      </span>
      <span
        class="absolute bottom-3 right-3 inline-flex items-center justify-center w-12 h-12 rounded-full bg-brand text-brand-fg shadow-lg ring-4 ring-text"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
        </svg>
      </span>
    </div>

    <!-- RIGHT: eyebrow + name + body + chips + CTA pair -->
    <div class="lg:col-span-7">
      <p class="font-body text-xs font-bold tracking-widest uppercase text-brand mb-2">
        {eyebrowLabel} {padded}
      </p>
      <h3 class="font-heading font-extrabold text-2xl lg:text-3xl text-brand-fg leading-tight">
        {name}
      </h3>
      <p class="font-body text-sm lg:text-base text-brand-fg/75 mt-3 leading-relaxed">
        {body}
      </p>

      {chips.length > 0 && (
        <div class="mt-5">
          {chipsHeading && (
            <p class="font-body text-[11px] font-bold tracking-widest uppercase text-brand-fg/50 mb-2">
              {chipsHeading}
            </p>
          )}
          <ul class="flex flex-wrap gap-2" role="list">
            {chips.map((chip) => (
              <li>
                <span class="inline-flex items-center gap-1.5 bg-brand-fg/10 text-brand-fg/90 font-body text-xs font-semibold px-3 py-1.5 rounded-full ring-1 ring-brand-fg/15">
                  <svg class="w-3 h-3 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  {chip}
                </span>
              </li>
            ))}
            {chipsRestCount > 0 && (
              <li>
                <span class="inline-flex items-center bg-transparent text-brand-fg/60 font-body text-xs font-semibold px-2 py-1.5">
                  + {chipsRestCount} more
                </span>
              </li>
            )}
          </ul>
        </div>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={primaryCta.href}
          class="inline-flex items-center justify-center gap-2 bg-brand hover:bg-brand-deep text-brand-fg font-body font-bold text-sm px-6 py-3 rounded-full shadow-md hover:shadow-lg hover:scale-[1.02] transition-all"
        >
          {primaryCta.label}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center gap-1.5 font-body text-sm font-semibold text-brand-fg/80 hover:text-brand-fg transition-colors"
        >
          {secondaryCta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

  </article>
</li>
