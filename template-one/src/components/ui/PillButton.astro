---
/**
 * PillButton — the primary CTA shape used across the site.
 *
 * One component covers four visual treatments so every CTA pulls from
 * the same source of truth:
 *
 *   primary     , solid brand bg + white fg + scale-on-hover. Default
 *                 hero CTA on light AND dark backgrounds.
 *   outline-fg  , transparent + ring of brand-fg. Pairs with `primary`
 *                 as the secondary CTA on dark heroes.
 *   outline-text, transparent + ring of border. Secondary CTA on
 *                 light backgrounds (e.g. WhenYouNeedService).
 *   inverse     , bg-brand-fg + text-brand. Used on teal/brand
 *                 sections (TestimonialsTeal, ServiceCardsTeal,
 *                 GuaranteeBanner, etc.) where the page bg is teal.
 *
 * Optional inline icons (`iconLeft` / `iconRight`) cover the two SVGs
 * that show up everywhere — the right arrow and the phone glyph — so
 * call-sites don't repeat the markup.
 *
 * Use a slot for the label so call-sites can interpolate dynamic
 * content (e.g. `Call {business.phone}`) without escaping.
 */
type Variant = "primary" | "outline-fg" | "outline-text" | "inverse";
type Size = "sm" | "md" | "lg";
type Icon = "arrow" | "phone";

interface Props {
  href: string;
  variant?: Variant;
  size?: Size;
  iconLeft?: Icon;
  iconRight?: Icon;
  /** Adds whitespace-nowrap. Useful for "Call (555) 555-5555". */
  nowrap?: boolean;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "lg",
  iconLeft,
  iconRight,
  nowrap = false,
  class: className,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 font-body font-bold rounded-full transition-all";

const sizeClass: Record<Size, string> = {
  sm: "text-sm px-6 py-3",
  md: "text-base px-7 py-3.5",
  lg: "text-base lg:text-lg px-8 py-4",
};

const variantClass: Record<Variant, string> = {
  primary:
    "bg-brand hover:bg-brand-deep text-brand-fg shadow-lg hover:shadow-xl hover:scale-[1.02]",
  "outline-fg":
    "bg-transparent text-brand-fg ring-2 ring-brand-fg/70 hover:bg-brand-fg hover:text-text",
  "outline-text":
    "bg-transparent text-text ring-2 ring-border hover:ring-brand hover:text-brand",
  inverse:
    "bg-brand-fg text-brand shadow-lg hover:bg-brand-tint hover:scale-[1.02]",
};
---

<a
  href={href}
  class:list={[
    base,
    sizeClass[size],
    variantClass[variant],
    nowrap ? "whitespace-nowrap" : "",
    className,
  ]}
>
  {iconLeft === "phone" && (
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
    </svg>
  )}
  <slot />
  {iconRight === "arrow" && (
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  )}
  {iconRight === "phone" && (
    <svg class="w-5 h-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 15.352V16.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd"/>
    </svg>
  )}
</a>
