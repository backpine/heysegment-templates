---
/**
 * AboutHero — dark navy page-header for /about.
 *
 * A thin wrapper around PageHero that:
 *   - Computes the local-SEO H1 pill ("About [Business] in [City, State]")
 *   - Carries the About-page-specific placeholder hint
 *
 * Everything structural (background, overlay, breadcrumbs-inside,
 * pill H1, dual CTA pair) lives in PageHero so the same rhythm applies
 * across the site.
 */
import { business } from "@/data/business";
import PageHero from "@/components/global/PageHero.astro";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  /** Bold visual tagline beneath the H1 pill, max ~7 words. */
  tagline?: string;
  /** Short subhead paragraph below the tagline. */
  subtext?: string;
  primaryCta?: { label: string; href: string };
  /** Breadcrumb trail rendered INSIDE the hero (overlay variant). */
  breadcrumbs?: Crumb[];
}

const city = business.address?.city;
const state = business.address?.state;
const cityState = state ? `${city}, ${state}` : city ?? "Your Area";

const {
  tagline = "Lorem ipsum dolor sit amet.",
  subtext,
  primaryCta = { label: business.ctaLabel, href: business.ctaHref },
  breadcrumbs,
} = Astro.props;

const h1Pill = `About ${business.name} in ${cityState}`;
---

<PageHero
  h1Pill={h1Pill}
  tagline={tagline}
  subtext={subtext}
  primaryCta={primaryCta}
  breadcrumbs={breadcrumbs}
  placeholderLabel="ABOUT PAGE BACKGROUND"
  placeholderHint="Wide hero photo, owner / team shot or branded vehicle"
/>
